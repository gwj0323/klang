<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Klang_WinUI.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    CloseButtonText="完成"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>

        <!-- 一组设置一张卡片，组内每项一行，行之间一条细线（和 AI 功能页一致） -->
        <Style x:Key="SettingGroup" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="14,12,14,12" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 页内分组小标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,8,0,0" />
        </Style>
    </ContentDialog.Resources>

    <NavigationView
        x:Name="SettingsNav"
        Width="760"
        Height="540"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="160"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="常规" IsSelected="True" Tag="general">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="外观" Tag="appearance">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="歌词" Tag="lyrics">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="播放与音频" Tag="playback">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="曲库与云端" Tag="library">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="AI 功能" Tag="ai">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="8,0,0,0">

            <!-- ============ 常规 ============ -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="常规" />

                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="语言 / Language" />
                                    <TextBlock Style="{StaticResource Desc}" Text="立即生效" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="LanguageComboBox_SelectionChanged" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="点击关闭按钮时" />
                                    <TextBlock Style="{StaticResource Desc}" Text="最小化到托盘时继续在后台播放。" />
                                </StackPanel>
                                <ComboBox x:Name="CloseActionBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="CloseActionBox_SelectionChanged">
                                    <ComboBoxItem Content="每次询问" Tag="ask" />
                                    <ComboBoxItem Content="最小化到托盘" Tag="tray" />
                                    <ComboBoxItem Content="退出程序" Tag="exit" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 外观 ============ -->
            <ScrollViewer x:Name="PageAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="外观" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="窗口" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="主题" />
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="背景材质" />
                                <ComboBox x:Name="BackdropComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="BackdropComboBox_SelectionChanged">
                                    <ComboBoxItem Content="云母 (Mica)" Tag="mica" />
                                    <ComboBoxItem Content="亚克力 (Acrylic)" Tag="acrylic" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="主界面" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="黑胶唱片" />
                                    <TextBlock Style="{StaticResource Desc}" Text="播放时，封面后方滑出一张旋转的唱片" />
                                </StackPanel>
                                <ToggleSwitch x:Name="VinylDiscSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="VinylDiscSwitch_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="动态封面" />
                                    <TextBlock Style="{StaticResource Desc}" Text="网易云歌曲有动态封面时在封面位置循环播放。需要登录网易云。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DynamicCoverSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="DynamicCoverSwitch_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="波形进度条" />
                                    <TextBlock Style="{StaticResource Desc}" Text="底栏进度条显示歌曲的波形。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="WaveformSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="WaveformSwitch_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="沉浸背景" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="随时段变化" />
                                    <TextBlock Style="{StaticResource Desc}" Text="深夜更暗更慢，傍晚偏暖。只用本机时间。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AmbientTodSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="AmbientTodSwitch_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <StackPanel Padding="14,12,14,12" Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Label}" Text="天气效果" />
                                        <TextBlock Style="{StaticResource Desc}" Text="按所在城市的天气叠加淡淡的雨、雪、雾或闪电。" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AmbientWeatherSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="AmbientWeatherSwitch_Toggled" />
                                </Grid>
                                <StackPanel x:Name="WeatherPanel" Spacing="8" Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="CityBox" PreviewKeyDown="CityBox_KeyDown" PlaceholderText="输入城市名称，如 北京、Copenhagen" />
                                        <Button x:Name="CitySearchBtn" Grid.Column="1" Click="CitySearchBtn_Click" Content="查找" />
                                    </Grid>
                                    <ComboBox x:Name="CityResults" HorizontalAlignment="Stretch" PlaceholderText="选择城市"
                                              SelectionChanged="CityResults_SelectionChanged" Visibility="Collapsed" />
                                    <TextBlock x:Name="WeatherStatusText" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                               Text="天气来自 Open-Meteo，每 30 分钟发送一次城市的大致位置（约 1 公里精度），不发送其他信息。" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 歌词 ============ -->
            <ScrollViewer x:Name="PageLyrics" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="歌词" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="显示" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="歌词字号" />
                                    <TextBlock Style="{StaticResource Desc}" Text="也可以按 Ctrl + / Ctrl -" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Slider x:Name="LyricSizeSlider" Width="120" VerticalAlignment="Center" Maximum="40" Minimum="14"
                                            ValueChanged="LyricSizeSlider_ValueChanged" />
                                    <TextBlock x:Name="LyricSizeText" Width="28" VerticalAlignment="Center" FontSize="12" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="放大强调当前句" />
                                    <TextBlock Style="{StaticResource Desc}" Text="当前句放大，其余缩小" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LyricZoomSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="LyricZoomSwitch_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="景深模糊" />
                                    <TextBlock Style="{StaticResource Desc}" Text="离当前句越远的行越模糊；手动滚动时取消" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LyricBlurSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="LyricBlurSwitch_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="逐字动效" />
                                    <TextBlock Style="{StaticResource Desc}" Text="逐字歌词唱到的字轻微上移，长音加辉光" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LyricWordMotionSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="LyricWordMotionSwitch_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="性能" />
                    <Border Style="{StaticResource SettingGroup}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Text="歌词帧率" />
                                <TextBlock Style="{StaticResource Desc}" Text="调低可以省电，动画速度不变。" />
                            </StackPanel>
                            <ComboBox x:Name="LyricFrameRateBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="LyricFrameRateBox_SelectionChanged">
                                <ComboBoxItem Content="跟随屏幕刷新率" Tag="0" />
                                <ComboBoxItem Content="120 帧" Tag="120" />
                                <ComboBoxItem Content="60 帧" Tag="60" />
                                <ComboBoxItem Content="30 帧" Tag="30" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 播放与音频 ============ -->
            <ScrollViewer x:Name="PagePlayback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="播放与音频" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="输出" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="输出设备" />
                                <ComboBox x:Name="DeviceComboBox" Grid.Column="1" Width="230" VerticalAlignment="Center"
                                          SelectionChanged="DeviceComboBox_SelectionChanged" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="WASAPI 独占模式" />
                                    <TextBlock Style="{StaticResource Desc}" Text="按文件原始采样率输出。开启后其他应用不能同时发声。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ExclusiveSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="ExclusiveSwitch_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="WASAPI 输出缓冲" />
                                    <TextBlock Style="{StaticResource Desc}" Text="值越大越稳定" />
                                </StackPanel>
                                <ComboBox x:Name="LatencyComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="LatencyComboBox_SelectionChanged">
                                    <ComboBoxItem Content="30 ms (最低延迟)" Tag="30" />
                                    <ComboBoxItem Content="50 ms (默认)" Tag="50" />
                                    <ComboBoxItem Content="100 ms" Tag="100" />
                                    <ComboBoxItem Content="200 ms (最稳)" Tag="200" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="绕过全部音效" />
                                    <TextBlock Style="{StaticResource Desc}" Text="关掉均衡器、空间音效等全部处理。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="BypassSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="BypassSwitch_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="音量" />
                    <Border Style="{StaticResource SettingGroup}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Text="回放增益 (ReplayGain)" />
                                <TextBlock Style="{StaticResource Desc}" Text="统一不同歌曲的响度" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ReplayGainSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="ReplayGainSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="切歌过渡" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="自动混音" />
                                    <TextBlock Style="{StaticResource Desc}" Text="歌曲快结束时和下一首交叉淡入淡出，速度接近时对齐节拍。" />
                                </StackPanel>
                                <ComboBox x:Name="AutoMixComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="AutoMixComboBox_SelectionChanged">
                                    <ComboBoxItem Content="关闭" Tag="off" />
                                    <ComboBoxItem Content="仅漫游模式" Tag="roam" />
                                    <ComboBoxItem Content="所有播放模式" Tag="all" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="混音时长" />
                                    <TextBlock Style="{StaticResource Desc}" Text="对齐节拍时按整小节取整。" />
                                </StackPanel>
                                <ComboBox x:Name="AutoMixLengthComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="AutoMixLengthComboBox_SelectionChanged">
                                    <ComboBoxItem Content="短（约 4 秒）" Tag="short" />
                                    <ComboBoxItem Content="标准（约 8 秒）" Tag="normal" />
                                    <ComboBoxItem Content="长（约 12 秒）" Tag="long" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="定时" />
                    <Border Style="{StaticResource SettingGroup}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Text="睡眠定时" />
                                <TextBlock x:Name="SleepStatusText" Style="{StaticResource Desc}" Text="到时自动暂停播放" />
                            </StackPanel>
                            <ComboBox x:Name="SleepComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                      SelectionChanged="SleepComboBox_SelectionChanged">
                                <ComboBoxItem Content="不设定时" Tag="0" />
                                <ComboBoxItem Content="15 分钟" Tag="15" />
                                <ComboBoxItem Content="30 分钟" Tag="30" />
                                <ComboBoxItem Content="45 分钟" Tag="45" />
                                <ComboBoxItem Content="60 分钟" Tag="60" />
                                <ComboBoxItem Content="90 分钟" Tag="90" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 曲库与云端 ============ -->
            <ScrollViewer x:Name="PageLibrary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="曲库与云端" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="音乐文件夹" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel Padding="14,12,14,12" Spacing="8">
                            <TextBlock Style="{StaticResource Desc}" Text="文件夹中的变化将自动同步" />
                            <StackPanel x:Name="FoldersPanel" Spacing="4" />
                            <TextBlock x:Name="LibraryStatusText" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RescanBtn" Click="RescanBtn_Click" Content="重新扫描" />
                                <Button x:Name="ClearLibraryBtn" Click="ClearLibraryBtn_Click" Content="清空曲库" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="联网补全" />
                    <Border Style="{StaticResource SettingGroup}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Text="自动补全封面与歌词" />
                                <TextBlock Style="{StaticResource Desc}" Text="缺封面、专辑或歌词时从网易云和 LRCLIB 查找，会发送歌名、歌手、专辑和时长。" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoMetaSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="AutoMetaSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="云端音乐" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <StackPanel Padding="14,12,14,12" Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Label}" Text="保存到曲库的位置" />
                                        <TextBlock Style="{StaticResource Desc}" Text="云端歌曲“保存到曲库”时存到这里。更改后已保存的文件不会移动。" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SaveFolderBtn" Click="SaveFolderBtn_Click" Content="更改…" />
                                        <Button x:Name="SaveFolderResetBtn" Click="SaveFolderResetBtn_Click" Content="恢复默认" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SaveFolderText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="音乐缓存上限（每个平台）" />
                                    <TextBlock x:Name="CacheInfoText" Style="{StaticResource Desc}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="CacheLimitBox" Width="120" SelectionChanged="CacheLimitBox_SelectionChanged">
                                        <ComboBoxItem Content="512 MB" Tag="512" />
                                        <ComboBoxItem Content="1 GB" Tag="1024" />
                                        <ComboBoxItem Content="2 GB" Tag="2048" />
                                        <ComboBoxItem Content="5 GB" Tag="5120" />
                                        <ComboBoxItem Content="10 GB" Tag="10240" />
                                    </ComboBox>
                                    <Button x:Name="ClearCacheBtn" Click="ClearCacheBtn_Click" Content="清理缓存" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="收听数据" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="听歌记录" />
                                    <TextBlock x:Name="ListenInfoText" Style="{StaticResource Desc}" />
                                </StackPanel>
                                <Button x:Name="ClearListenBtn" Grid.Column="1" VerticalAlignment="Center" Click="ClearListenBtn_Click" Content="清空听歌记录" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="漫游学习数据" />
                                    <TextBlock x:Name="RoamInfoText" Style="{StaticResource Desc}" />
                                </StackPanel>
                                <Button x:Name="ResetRoamBtn" Grid.Column="1" VerticalAlignment="Center" Click="ResetRoamBtn_Click" Content="重置" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ AI 功能（内容在代码里生成：Controls/AiSettingsPanel） ============ -->
            <ScrollViewer x:Name="PageAi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" />

            <!-- ============ 关于 ============ -->
            <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="关于" />

                    <Border Style="{StaticResource SettingGroup}">
                        <Grid Padding="14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Width="56" Height="56" VerticalAlignment="Top" Source="ms-appx:///Assets/AppLogo.png" Tapped="AppLogo_Tapped" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Klang" />
                                <TextBlock x:Name="AppVersionText" Style="{StaticResource Desc}" />
                                <TextBlock Style="{StaticResource Desc}" Text="Windows 音乐播放器（WinUI 3 / .NET 10）" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="更新" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel>
                            <StackPanel Padding="14,12,14,12" Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Label}" Text="检查更新" />
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Desc}" Text="查看 GitHub 上的新版本" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                        <Button x:Name="CheckUpdateBtn" Click="CheckUpdateBtn_Click" Content="检查更新" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="UpdateResultPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock x:Name="UpdateTitleText" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Desc}" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DownloadUpdateBtn" Click="DownloadUpdateBtn_Click" Content="下载新版本" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="ReleasePageBtn" Click="ReleasePageBtn_Click" Content="查看发布页" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="安装前请先退出 Klang。" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="启动时自动检查更新" />
                                    <TextBlock Style="{StaticResource Desc}" Text="有新版本时提示，不会自动下载。不发送个人信息。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCheckUpdateSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="AutoCheckUpdateSwitch_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="链接与数据" />
                    <Border Style="{StaticResource SettingGroup}">
                        <StackPanel Padding="14,12,14,12" Spacing="6">
                            <HyperlinkButton Padding="0" Content="GitHub 项目主页" NavigateUri="https://github.com/gwj0323/klang" />
                            <HyperlinkButton Padding="0" Content="所有发布版本" NavigateUri="https://github.com/gwj0323/klang/releases" />
                            <HyperlinkButton Padding="0" Content="反馈问题" NavigateUri="https://github.com/gwj0323/klang/issues" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                                <Button Click="OpenErrorLogBtn_Click" Content="打开错误日志" />
                                <Button Click="OpenDataFolderBtn_Click" Content="打开数据文件夹" />
                            </StackPanel>
                            <TextBlock x:Name="StatePathText" Margin="0,4,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Klang_WinUI.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    CloseButtonText="完成"
    DefaultButton="Close"
    mc:Ignorable="d">

    <StackPanel Width="400" Spacing="14">
        <!-- 材质设置 -->
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock FontWeight="Medium" Text="背景材质" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="云母 (Mica) / 亚克力 (Acrylic)" />
                </StackPanel>

                <ComboBox
                    x:Name="BackdropComboBox"
                    Grid.Column="1"
                    Width="140"
                    SelectedIndex="0"
                    SelectionChanged="BackdropComboBox_SelectionChanged">
                    <ComboBoxItem Content="云母 (Mica)" />
                    <ComboBoxItem Content="亚克力 (Acrylic)" />
                    <ComboBoxItem Content="标准纯色" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- WASAPI 缓冲 -->
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock FontWeight="Medium" Text="WASAPI 输出缓冲" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="低延迟共享缓冲模式 (50ms)" />
                </StackPanel>

                <ToggleSwitch Grid.Column="1" IsOn="True" OnContent="开启" OffContent="关闭" />
            </Grid>
        </Border>

        <!-- 关于信息 -->
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Klang" />
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="基于 Windows App SDK (.NET 10) 的现代音乐播放器" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>

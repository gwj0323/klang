<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Klang_WinUI.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    CloseButtonText="完成"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>

        <!-- 设置项卡片 -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- 页内分组小标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,8,0,0" />
        </Style>
    </ContentDialog.Resources>

    <NavigationView
        x:Name="SettingsNav"
        Width="680"
        Height="460"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="160"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="外观" IsSelected="True" Tag="appearance">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="播放与音频" Tag="playback">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="曲库" Tag="library">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="网络与缓存" Tag="network">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="8,0,0,0">

            <!-- ============ 外观 ============ -->
            <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="外观" />

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="语言 / Language" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="立即生效" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="LanguageComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="LanguageComboBox_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="主题" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="背景材质" />
                            </StackPanel>
                            <ComboBox
                                x:Name="BackdropComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="BackdropComboBox_SelectionChanged">
                                <ComboBoxItem Content="云母 (Mica)" Tag="mica" />
                                <ComboBoxItem Content="亚克力 (Acrylic)" Tag="acrylic" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="黑胶唱片" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="播放时，封面后方滑出一张旋转的唱片" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="VinylDiscSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="VinylDiscSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="波形进度条" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="底栏进度条显示当前曲目的振幅波形；关闭后使用标准滑块" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="WaveformSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="WaveformSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="沉浸背景氛围" />
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="随时段变化" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按当前时间调整背景的色温、亮度和流动速度：深夜更暗、更慢，傍晚偏暖。只使用本机时间，不联网。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AmbientTodSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="AmbientTodSwitch_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="Medium" Text="天气效果" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按所在城市的天气，在背景上叠加很淡的效果：下雨时玻璃蒙上一层雾气、布满水珠，不时有水珠滑落并擦出一道水路，下雪时有稀疏的雪花，阴天降低饱和度。" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AmbientWeatherSwitch"
                                    Grid.Column="1"
                                    OffContent="关"
                                    OnContent="开"
                                    Toggled="AmbientWeatherSwitch_Toggled" />
                            </Grid>
                            <StackPanel x:Name="WeatherPanel" Spacing="8" Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CityBox" PreviewKeyDown="CityBox_KeyDown" PlaceholderText="输入城市名称，如 北京、Copenhagen" />
                                    <Button x:Name="CitySearchBtn" Grid.Column="1" Click="CitySearchBtn_Click" Content="查找" />
                                </Grid>
                                <ComboBox
                                    x:Name="CityResults"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="选择城市"
                                    SelectionChanged="CityResults_SelectionChanged"
                                    Visibility="Collapsed" />
                                <TextBlock x:Name="WeatherStatusText" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="数据来自 Open-Meteo。查找城市时会发送输入的城市名称；之后每 30 分钟发送一次该城市的经纬度（保留两位小数，约 1 公里精度）。不发送账号、设备或播放信息。关闭后不再联网。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="歌词" />
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="放大强调当前句" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前句放大，其余缩小" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="LyricZoomSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="LyricZoomSwitch_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="景深模糊" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="离当前句越远的行越模糊；手动滚动时取消" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="LyricBlurSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="LyricBlurSwitch_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="逐字动效" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="逐字歌词唱到的字轻微上移，长音加辉光" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="LyricWordMotionSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="LyricWordMotionSwitch_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="歌词字号" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="也可以按 Ctrl + / Ctrl -" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Slider
                                    x:Name="LyricSizeSlider"
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Maximum="40"
                                    Minimum="14"
                                    ValueChanged="LyricSizeSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="LyricSizeText"
                                    Width="28"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 播放与音频 ============ -->
            <ScrollViewer x:Name="PagePlayback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="播放与音频" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="输出" />
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="输出设备" />
                            </StackPanel>
                            <ComboBox
                                x:Name="DeviceComboBox"
                                Grid.Column="1"
                                Width="230"
                                SelectionChanged="DeviceComboBox_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="WASAPI 独占模式" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按文件原始采样率输出，绕过 Windows 混音器。开启后其他应用将无法发声。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ExclusiveSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="ExclusiveSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="绕过全部音效" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="关闭均衡器、空间音效等全部音频处理，原样输出。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="BypassSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="BypassSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="WASAPI 输出缓冲" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="值越大越稳定" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="LatencyComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="LatencyComboBox_SelectionChanged">
                                <ComboBoxItem Content="30 ms (最低延迟)" Tag="30" />
                                <ComboBoxItem Content="50 ms (默认)" Tag="50" />
                                <ComboBoxItem Content="100 ms" Tag="100" />
                                <ComboBoxItem Content="200 ms (最稳)" Tag="200" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="切歌过渡" />
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="自动混音" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="歌曲临近结束时与下一首交叉淡入淡出。速度相差 8% 以内时对齐节拍并做低频交接；否则做普通的交叉淡入淡出，并跳过首尾的静音。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="AutoMixComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="AutoMixComboBox_SelectionChanged">
                                <ComboBoxItem Content="关闭" Tag="off" />
                                <ComboBoxItem Content="仅漫游模式" Tag="roam" />
                                <ComboBoxItem Content="所有播放模式" Tag="all" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="混音时长" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="对齐节拍时取最接近的整小节（4 / 8 / 16 / 32 拍）；两首调性不相容时自动减半。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="AutoMixLengthComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="AutoMixLengthComboBox_SelectionChanged">
                                <ComboBoxItem Content="短（约 4 秒）" Tag="short" />
                                <ComboBoxItem Content="标准（约 8 秒）" Tag="normal" />
                                <ComboBoxItem Content="长（约 12 秒）" Tag="long" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="音量与定时" />
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="回放增益 (ReplayGain)" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="统一不同歌曲的响度" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ReplayGainSwitch"
                                Grid.Column="1"
                                OffContent="关"
                                OnContent="开"
                                Toggled="ReplayGainSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="睡眠定时" />
                                <TextBlock
                                    x:Name="SleepStatusText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="到时自动暂停播放" />
                            </StackPanel>
                            <ComboBox
                                x:Name="SleepComboBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="SleepComboBox_SelectionChanged">
                                <ComboBoxItem Content="不设定时" Tag="0" />
                                <ComboBoxItem Content="15 分钟" Tag="15" />
                                <ComboBoxItem Content="30 分钟" Tag="30" />
                                <ComboBoxItem Content="45 分钟" Tag="45" />
                                <ComboBoxItem Content="60 分钟" Tag="60" />
                                <ComboBoxItem Content="90 分钟" Tag="90" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 曲库 ============ -->
            <ScrollViewer x:Name="PageLibrary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="曲库" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="音乐文件夹" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="文件夹中的变化将自动同步" TextWrapping="Wrap" />
                            <StackPanel x:Name="FoldersPanel" Spacing="4" />
                            <TextBlock
                                x:Name="LibraryStatusText"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RescanBtn" Click="RescanBtn_Click" Content="重新扫描" />
                                <Button x:Name="ClearLibraryBtn" Click="ClearLibraryBtn_Click" Content="清空曲库" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="元数据" />
                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="Medium" Text="自动补全封面与歌词" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="为缺少封面、专辑或歌词的歌曲联网查找（网易云、LRCLIB），将发送歌名、歌手、专辑和时长。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoMetaSwitch"
                                Grid.Column="1"
                                OffContent=""
                                OnContent=""
                                Toggled="AutoMetaSwitch_Toggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 网络与缓存 ============ -->
            <ScrollViewer x:Name="PageNetwork" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="网络与缓存" />

                    <TextBlock Style="{StaticResource GroupTitle}" Text="网易云" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="Medium" Text="音乐缓存" />
                            <TextBlock
                                x:Name="CacheInfoText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="缓存上限" />
                                <ComboBox
                                    x:Name="CacheLimitBox"
                                    Grid.Column="1"
                                    Width="150"
                                    SelectionChanged="CacheLimitBox_SelectionChanged">
                                    <ComboBoxItem Content="512 MB" Tag="512" />
                                    <ComboBoxItem Content="1 GB" Tag="1024" />
                                    <ComboBoxItem Content="2 GB" Tag="2048" />
                                    <ComboBoxItem Content="5 GB" Tag="5120" />
                                    <ComboBoxItem Content="10 GB" Tag="10240" />
                                </ComboBox>
                            </Grid>
                            <Button x:Name="ClearCacheBtn" Click="ClearCacheBtn_Click" Content="清理缓存" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 关于 ============ -->
            <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="关于" />

                    <Border Style="{StaticResource SettingCard}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="56"
                                Height="56"
                                VerticalAlignment="Top"
                                Source="ms-appx:///Assets/AppLogo.png" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Klang" />
                                <TextBlock
                                    x:Name="AppVersionText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Windows 音乐播放器（WinUI 3 / .NET 10）"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="更新" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="Medium" Text="检查更新" />
                                    <TextBlock
                                        x:Name="UpdateStatusText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="查看 GitHub 上的新版本"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <ProgressRing
                                        x:Name="UpdateRing"
                                        Width="20"
                                        Height="20"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <Button x:Name="CheckUpdateBtn" Click="CheckUpdateBtn_Click" Content="检查更新" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="UpdateResultPanel" Spacing="8" Visibility="Collapsed">
                                <MenuFlyoutSeparator />
                                <TextBlock
                                    x:Name="UpdateTitleText"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="UpdateNotesText"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="DownloadUpdateBtn"
                                        Click="DownloadUpdateBtn_Click"
                                        Content="下载新版本"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="ReleasePageBtn" Click="ReleasePageBtn_Click" Content="查看发布页" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="安装前请先退出 Klang。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupTitle}" Text="链接与数据" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel Spacing="6">
                            <HyperlinkButton
                                Padding="0"
                                Content="GitHub 项目主页"
                                NavigateUri="https://github.com/gwj0323/klang" />
                            <HyperlinkButton
                                Padding="0"
                                Content="所有发布版本"
                                NavigateUri="https://github.com/gwj0323/klang/releases" />
                            <HyperlinkButton
                                Padding="0"
                                Content="反馈问题"
                                NavigateUri="https://github.com/gwj0323/klang/issues" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                                <Button Click="OpenErrorLogBtn_Click" Content="打开错误日志" />
                                <Button Click="OpenDataFolderBtn_Click" Content="打开数据文件夹" />
                            </StackPanel>
                            <TextBlock
                                x:Name="StatePathText"
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</ContentDialog>

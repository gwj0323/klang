<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Klang_WinUI.Dialogs.EqualizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="音效"
    CloseButtonText="完成"
    DefaultButton="Close"
    PrimaryButtonText="恢复默认"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- 单个频段：数值 / 竖向滑块 / 频率 -->
        <Style x:Key="BandValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="BandFreqStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="600"
        Padding="0,0,16,0"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Width="440" Spacing="24">

            <!-- 预设 -->
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="预设" />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                    <Button x:Name="PresetDefaultBtn" Grid.Column="0" HorizontalAlignment="Stretch" Click="PresetBtn_Click" Tag="默认原声">
                        <TextBlock FontSize="12" Text="原声" />
                    </Button>
                    <Button x:Name="PresetVocalBtn" Grid.Column="1" HorizontalAlignment="Stretch" Click="PresetBtn_Click" Tag="流行人声">
                        <TextBlock FontSize="12" Text="人声" />
                    </Button>
                    <Button x:Name="PresetBassBtn" Grid.Column="2" HorizontalAlignment="Stretch" Click="PresetBtn_Click" Tag="低音增强">
                        <TextBlock FontSize="12" Text="低音" />
                    </Button>
                    <Button x:Name="PresetTrebleBtn" Grid.Column="3" HorizontalAlignment="Stretch" Click="PresetBtn_Click" Tag="清澈高音">
                        <TextBlock FontSize="12" Text="高音" />
                    </Button>
                    <Button x:Name="PresetLiveBtn" Grid.Column="4" HorizontalAlignment="Stretch" Click="PresetBtn_Click" Tag="现场空间">
                        <TextBlock FontSize="12" Text="现场" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 均衡器：五个频段竖排 -->
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="均衡器" />
                    <TextBlock
                        x:Name="CurrentPresetLabel"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前预设：原声" />
                </Grid>

                <Border
                    Padding="12,14,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock x:Name="Val60Hz" Style="{StaticResource BandValueStyle}" Text="0.0 dB" />
                            <Slider x:Name="Slider60Hz" Height="150" HorizontalAlignment="Center" Maximum="12" Minimum="-12" Orientation="Vertical" StepFrequency="0.5" ValueChanged="EqSlider_ValueChanged" />
                            <TextBlock Style="{StaticResource BandFreqStyle}" Text="60 Hz" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="Val230Hz" Style="{StaticResource BandValueStyle}" Text="0.0 dB" />
                            <Slider x:Name="Slider230Hz" Height="150" HorizontalAlignment="Center" Maximum="12" Minimum="-12" Orientation="Vertical" StepFrequency="0.5" ValueChanged="EqSlider_ValueChanged" />
                            <TextBlock Style="{StaticResource BandFreqStyle}" Text="230 Hz" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock x:Name="Val910Hz" Style="{StaticResource BandValueStyle}" Text="0.0 dB" />
                            <Slider x:Name="Slider910Hz" Height="150" HorizontalAlignment="Center" Maximum="12" Minimum="-12" Orientation="Vertical" StepFrequency="0.5" ValueChanged="EqSlider_ValueChanged" />
                            <TextBlock Style="{StaticResource BandFreqStyle}" Text="910 Hz" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="6">
                            <TextBlock x:Name="Val3600Hz" Style="{StaticResource BandValueStyle}" Text="0.0 dB" />
                            <Slider x:Name="Slider3600Hz" Height="150" HorizontalAlignment="Center" Maximum="12" Minimum="-12" Orientation="Vertical" StepFrequency="0.5" ValueChanged="EqSlider_ValueChanged" />
                            <TextBlock Style="{StaticResource BandFreqStyle}" Text="3.6 kHz" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="6">
                            <TextBlock x:Name="Val12000Hz" Style="{StaticResource BandValueStyle}" Text="0.0 dB" />
                            <Slider x:Name="Slider12000Hz" Height="150" HorizontalAlignment="Center" Maximum="12" Minimum="-12" Orientation="Vertical" StepFrequency="0.5" ValueChanged="EqSlider_ValueChanged" />
                            <TextBlock Style="{StaticResource BandFreqStyle}" Text="12 kHz" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 空间音效 -->
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="空间音效" />
                <ComboBox
                    x:Name="SpatialCombo"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="SpatialCombo_SelectionChanged">
                    <ComboBoxItem Content="杜比全景声风格（环绕 + 天空声道）" Tag="atmos" />
                    <ComboBoxItem Content="空间立体声（拓宽声场）" Tag="spatial" />
                    <ComboBoxItem Content="关闭" Tag="off" />
                </ComboBox>
            </StackPanel>

            <!-- 人声 / 伴奏 -->
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="人声与伴奏" />
                    <TextBlock
                        x:Name="VocalBalanceLabel"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="居中" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="压低人声" />
                    <Slider
                        x:Name="VocalBalanceSlider"
                        Grid.Column="1"
                        Maximum="1.0"
                        Minimum="-1.0"
                        StepFrequency="0.05"
                        ValueChanged="VocalBalanceSlider_ValueChanged" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="突出人声" />
                </Grid>
            </StackPanel>

            <!-- 黑胶质感 -->
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="黑胶质感" />
                    <TextBlock
                        x:Name="VinylWarmthLabel"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0%" />
                </Grid>
                <Slider
                    x:Name="VinylWarmthSlider"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="VinylWarmthSlider_ValueChanged" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="加一点谐波失真和底噪，声音更暖。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 耳机补偿 -->
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="耳机补偿" />
                <ComboBox
                    x:Name="HeadphoneCombo"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="HeadphoneCombo_SelectionChanged" />
                <TextBlock
                    x:Name="HeadphoneDescLabel"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="未启用。选择耳机型号后，会按它的频响曲线做补偿。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.LyricsStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Klang_WinUI.Controls"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!-- 视口：不再用 ScrollViewer。内容整体用合成器的弹簧动画平移（跑在合成线程，跟显示器刷新率走），
         滚轮 / 触控板只是改变平移目标。 -->
    <Grid
        x:Name="Viewport"
        Background="Transparent"
        PointerWheelChanged="Viewport_PointerWheelChanged"
        SizeChanged="Viewport_SizeChanged">

        <StackPanel
            x:Name="ContentPanel"
            Padding="24,0,24,0"
            VerticalAlignment="Top">
            <ItemsControl x:Name="LyricsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,6,0,6"
                            Padding="24,10,24,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="{Binding Text}"
                            Click="LyricLine_Click"
                            CornerRadius="8"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="点击跳转到此时刻播放">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <!-- 主歌词：缩放 / 透明度由代码在合成层上做动画，不再逐帧改绑定属性 -->
                                <local:KaraokeText
                                    FontSize="{Binding MainFontSize}"
                                    FontWeight="{Binding FontWeight}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Line="{Binding}" />

                                <!-- 副行：翻译 / 罗马音 -->
                                <TextBlock
                                    FontSize="{Binding SubFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding DisplaySub}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding SubVisibility}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 用户手动滚动时浮现的“回正”胶囊提示 -->
        <Button
            x:Name="ResumeCenterBtn"
            Height="30"
            Margin="0,0,28,24"
            Padding="12,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="返回当前播放位置"
            Click="ResumeCenterBtn_Click"
            CornerRadius="15"
            Opacity="0"
            Style="{StaticResource DefaultButtonStyle}"
            ToolTipService.ToolTip="返回当前播放位置"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8D7;" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="回到正在播放" />
            </StackPanel>
        </Button>

        <!-- 空歌词占位提示 -->
        <StackPanel
            x:Name="EmptyLyricsPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="Visible">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEC4F;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="暂无歌词" />
        </StackPanel>
    </Grid>
</UserControl>

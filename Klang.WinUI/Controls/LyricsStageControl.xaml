<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.LyricsStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Klang_WinUI.Controls"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid>
        <!-- 居中丝滑歌词滚动视口 (配备物理阻尼谐振弹簧系统) -->
        <ScrollViewer
            x:Name="LyricsScrollViewer"
            Padding="24,0,24,0"
            HorizontalScrollBarVisibility="Disabled"
            IsScrollInertiaEnabled="True"
            VerticalScrollBarVisibility="Hidden">

            <StackPanel>
                <Border x:Name="TopSpacer" Height="300" />
            <ItemsControl x:Name="LyricsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button AutomationProperties.Name="{Binding Text}"
                            Margin="0,6,0,6"
                            Padding="24,10,24,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="LyricLine_Click"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="点击跳转到此时刻播放">
                            <Button.RenderTransform>
                                <ScaleTransform
                                    ScaleX="{Binding ScaleX}"
                                    ScaleY="{Binding ScaleY}" />
                            </Button.RenderTransform>

                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <!-- 主歌词 (定长 22px 配合物理平滑缩放，杜绝文字突变回流抖动) -->
                                <local:KaraokeText
                                    FontSize="{Binding MainFontSize}"
                                    FontWeight="{Binding FontWeight}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Line="{Binding}"
                                    Opacity="{Binding LineOpacity}" />

                                <!-- 翻译歌词 (北欧鼠尾草绿辅助色) -->
                                <TextBlock
                                    FontSize="{Binding SubFontSize}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Opacity="{Binding LineOpacity}"
                                    Text="{Binding DisplaySub}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding SubVisibility}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <Border x:Name="BottomSpacer" Height="300" />
            </StackPanel>
        </ScrollViewer>

        <!-- 顶部柔和渐隐羽化遮罩 (Ethereal Mist Fade Out) -->
        <Border
            x:Name="TopFadeBorder"
            Height="90"
            Visibility="Collapsed"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />

        <!-- 底部柔和渐隐羽化遮罩 -->
        <Border
            x:Name="BottomFadeBorder"
            Height="90"
            Visibility="Collapsed"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False" />

        <!-- 用户手动滚动时浮现的“回正”胶囊提示 (Apple Music / Qt6 交互规范) -->
        <Button AutomationProperties.Name="返回当前播放位置"
            x:Name="ResumeCenterBtn"
            Height="30"
            Padding="12,0,12,0"
            Margin="0,0,28,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="ResumeCenterBtn_Click"
            CornerRadius="15"
            Opacity="0"
            Style="{StaticResource DefaultButtonStyle}"
            ToolTipService.ToolTip="返回当前播放位置"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8D7;" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="回到正在播放" />
            </StackPanel>
        </Button>

        <!-- 空歌词占位提示 -->
        <StackPanel
            x:Name="EmptyLyricsPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Visible">
            <FontIcon
                FontSize="36"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEC4F;" />
            <TextBlock
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="暂无歌词" />
        </StackPanel>
    </Grid>
</UserControl>

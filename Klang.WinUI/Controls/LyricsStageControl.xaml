<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.LyricsStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 歌词用 Win2D 逐帧绘制：每一帧都按“真实字号”重新排版和栅格化文字（而不是缩放一张文字纹理），
         所以放大 / 缩小 / 滚动过程中文字始终锐利。动画（错峰缓动）在代码里按帧计算。 -->
    <Grid
        x:Name="Viewport"
        Background="Transparent"
        PointerExited="Viewport_PointerExited"
        PointerMoved="Viewport_PointerMoved"
        PointerPressed="Viewport_PointerPressed"
        PointerReleased="Viewport_PointerReleased"
        PointerWheelChanged="Viewport_PointerWheelChanged"
        SizeChanged="Viewport_SizeChanged">

        <canvas:CanvasControl
            x:Name="LyricsCanvas"
            ClearColor="Transparent"
            Draw="LyricsCanvas_Draw" />

        <!-- 用户手动滚动时浮现的“回正”胶囊提示 -->
        <Button
            x:Name="ResumeCenterBtn"
            Height="30"
            Margin="0,0,28,24"
            Padding="12,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="返回当前播放位置"
            Click="ResumeCenterBtn_Click"
            CornerRadius="15"
            Opacity="0"
            Style="{StaticResource DefaultButtonStyle}"
            ToolTipService.ToolTip="返回当前播放位置"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8D7;" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="回到正在播放" />
            </StackPanel>
        </Button>

        <!-- 空歌词占位提示 -->
        <StackPanel
            x:Name="EmptyLyricsPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="Visible">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xEC4F;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="暂无歌词" />
        </StackPanel>
    </Grid>
</UserControl>

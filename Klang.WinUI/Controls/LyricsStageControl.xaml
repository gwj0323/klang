<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.LyricsStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- 居中丝滑歌词滚动视口 -->
        <ScrollViewer
            x:Name="LyricsScrollViewer"
            Padding="24,0,24,0"
            HorizontalScrollBarVisibility="Disabled"
            IsScrollInertiaEnabled="True"
            VerticalScrollBarVisibility="Hidden">

            <ItemsControl
                x:Name="LyricsItemsControl"
                Padding="0,260,0,260">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,5,0,5"
                            Padding="16,10,16,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="LyricLine_Click"
                            CornerRadius="10"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="点击跳转到此时刻播放">
                            <Button.RenderTransform>
                                <ScaleTransform
                                    ScaleX="{Binding ScaleX}"
                                    ScaleY="{Binding ScaleY}" />
                            </Button.RenderTransform>

                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <!-- 主歌词 -->
                                <TextBlock
                                    FontSize="{Binding MainFontSize}"
                                    FontWeight="{Binding FontWeight}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Opacity="{Binding LineOpacity}"
                                    Text="{Binding Text}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <!-- 翻译歌词 -->
                                <TextBlock
                                    FontSize="{Binding SubFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="{Binding LineOpacity}"
                                    Text="{Binding Sub}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.ImmersiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Klang_WinUI.Controls"
    RequestedTheme="Dark">

    <Grid x:Name="RootGrid" Background="#101418">
        <!-- 封面取色的流动网格渐变背景（移植自 Qt 版 fluid_shader） -->
        <controls:FluidBackground x:Name="Fluid" />

        <Grid Padding="72,56,64,56" ColumnSpacing="72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="560" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="InfoPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="20">
                <Border
                    Width="380"
                    Height="380"
                    CornerRadius="18"
                    Background="#22FFFFFF">
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Width="380" Spacing="4">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="White"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ArtistText"
                        FontSize="15"
                        Foreground="#CCFFFFFF"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <controls:LyricsStageControl x:Name="Lyrics" Grid.Column="1" />
        </Grid>

        <!-- 底部播放控制（Apple Music 风格）：无外框，底部渐变衬底，细进度条 + 大号图标；鼠标静止后淡出 -->
        <Grid
            x:Name="Dock"
            VerticalAlignment="Bottom"
            Padding="0,90,0,34">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Resources>
                <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E6FFFFFF" />
                <SolidColorBrush x:Key="SliderTrackFill" Color="#59FFFFFF" />
                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#73FFFFFF" />
                <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E6FFFFFF" />
                <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
                <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
            </Grid.Resources>

            <StackPanel
                Width="640"
                HorizontalAlignment="Center"
                Spacing="6">

                <!-- 进度：已播放在左，剩余在右 -->
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider
                        x:Name="ProgressSlider"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        StepFrequency="0.01"
                        ValueChanged="ProgressSlider_ValueChanged" />
                    <Grid Grid.Row="1" Margin="2,-8,2,0">
                        <TextBlock
                            x:Name="PosText"
                            FontSize="12"
                            Foreground="#B3FFFFFF"
                            Text="00:00" />
                        <TextBlock
                            x:Name="DurText"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="#B3FFFFFF"
                            Text="-00:00" />
                    </Grid>
                </Grid>

                <!-- 上一首 / 播放暂停 / 下一首：纯图标，不带底色 -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="36">
                    <Button
                        Width="56"
                        Height="56"
                        Padding="0"
                        AutomationProperties.Name="上一首"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Prev_Click"
                        CornerRadius="28"
                        Foreground="White"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="26" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        Width="64"
                        Height="64"
                        Padding="0"
                        AutomationProperties.Name="播放 / 暂停"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PlayPause_Click"
                        CornerRadius="32"
                        Foreground="White"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon x:Name="PlayIcon" FontSize="38" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        Width="56"
                        Height="56"
                        Padding="0"
                        AutomationProperties.Name="下一首"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Next_Click"
                        CornerRadius="28"
                        Foreground="White"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="26" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <!-- 音量 -->
                <Grid
                    Width="240"
                    HorizontalAlignment="Center"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="14"
                        Foreground="#B3FFFFFF"
                        Glyph="&#xE992;" />
                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="1"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="VolumeSlider_ValueChanged" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="14"
                        Foreground="#B3FFFFFF"
                        Glyph="&#xE995;" />
                </Grid>
            </StackPanel>
        </Grid>

        <Button AutomationProperties.Name="退出沉浸模式 (Esc)"
            Margin="0,20,24,0"
            Padding="12,8,12,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="Close_Click"
            CornerRadius="18"
            ToolTipService.ToolTip="退出沉浸模式 (Esc)">
            <FontIcon FontSize="14" Glyph="&#xE711;" />
        </Button>
    </Grid>
</UserControl>

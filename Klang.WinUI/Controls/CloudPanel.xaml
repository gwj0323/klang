<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.CloudPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Klang_WinUI.Models"
    xmlns:local="using:Klang_WinUI.Controls">

    <UserControl.Resources>
        <!-- 来源分段切换：选中的一段是凸起的按钮，其余是透明的文字 -->
        <Style x:Key="SegmentOffStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SegmentOnStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 云端来源分段切换：接入了不止一个平台时才显示；各段在代码里按来源生成 -->
        <Border
            x:Name="SourceSwitch"
            Padding="2"
            AutomationProperties.Name="云端来源"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <Grid x:Name="SourceSwitchGrid" ColumnSpacing="2" />
        </Border>

        <!-- 查看歌单 / 搜索结果时的返回条 -->
        <Grid
            x:Name="TracksHeader"
            Grid.Row="1"
            ColumnSpacing="6"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button AutomationProperties.Name="返回"
                Height="28"
                Padding="8,0,8,0"
                Click="BackBtn_Click"
                CornerRadius="4"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TracksHeaderText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="2">
            <!-- 未登录：二维码 / Cookie 登录 -->
            <ScrollViewer x:Name="LoginView" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="6,4,6,8">
                    <TextBlock
                        x:Name="LoginTitleText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="登录网易云音乐" />
                    <!-- 扫码方式（QQ / 微信）：来源支持多种时才显示 -->
                    <ComboBox
                        x:Name="QrModeBox"
                        MinWidth="120"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        SelectionChanged="QrModeBox_SelectionChanged"
                        Visibility="Collapsed" />
                    <Border
                        Width="168"
                        Height="168"
                        HorizontalAlignment="Center"
                        Background="White"
                        CornerRadius="8">
                        <Grid>
                            <Image x:Name="QrImage" Stretch="Uniform" />
                            <ProgressRing
                                x:Name="QrRing"
                                Width="28"
                                Height="28"
                                IsActive="False" />
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="QrStatusText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="用网易云音乐 App 扫码登录"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="RefreshQr_Click"
                        Content="刷新二维码"
                        FontSize="12" />

                    <Expander
                        x:Name="CookieExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <!-- 侧栏很窄：标题允许换行，不再被截断 -->
                        <Expander.Header>
                            <TextBlock
                                Margin="0,8,0,8"
                                FontSize="13"
                                Text="扫码登录不可用时，可使用 Cookie 登录"
                                TextWrapping="Wrap" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <!-- Cookie 是登录凭据：用密码框，不在屏幕上明文显示 -->
                            <PasswordBox
                                x:Name="CookieBox"
                                PlaceholderText="粘贴 MUSIC_U 或整段 Cookie" />
                            <Button
                                x:Name="CookieLoginBtn"
                                Click="CookieLogin_Click"
                                Content="登录"
                                FontSize="12" />
                            <TextBlock
                                x:Name="CookieStatusText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="无需登录即可搜索并试听：在上方输入关键字后按回车。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- 已登录：账号信息 + 每日推荐 / 我的歌单 -->
            <Grid x:Name="HomeView" RowSpacing="6" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 账号行：头像 + 昵称 + 当前音质；音质和退出登录收在“⋯”菜单里 -->
                <Grid Padding="4,2,0,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        x:Name="AvatarPicture"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="NicknameText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="QualityText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        ToolTipService.ToolTip="播放音质（不可用时自动降级）" />
                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="账号与音质"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="账号与音质">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="AccountMenu" Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                </Grid>
                <ListView
                    x:Name="HomeList"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="HomeList_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CloudEntry">
                            <Grid
                                Height="44"
                                Padding="8,0,8,0"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Subtitle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 曲目列表（每日推荐 / 歌单 / 搜索结果） -->
            <ListView
                x:Name="TracksList"
                IsItemClickEnabled="True"
                ItemClick="TracksList_ItemClick"
                SelectionMode="Single"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackItem">
                        <Grid
                Height="56"
                Padding="8,0,8,0"
                Background="Transparent"
                ColumnSpacing="12"
                ContextRequested="TrackRow_ContextRequested"
                ToolTipService.ToolTip="{x:Bind FormatBadge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 封面缩略图（没有封面时显示音符占位） -->
                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind CoverThumb, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind DurationStr}"
                    TextAlignment="Right" />
            </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 加载中：骨架屏 -->
            <local:SkeletonList x:Name="Skeleton" Visibility="Collapsed" />

            <!-- 加载 / 空结果提示 -->
            <StackPanel
                x:Name="BusyPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <ProgressRing x:Name="BusyRing" Width="28" Height="28" IsActive="False" />
                <TextBlock
                    x:Name="BusyText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 保存到曲库等操作的提示（几秒后自动消失） -->
            <Border
                x:Name="ToastBorder"
                Margin="8,0,8,10"
                Padding="12,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </Border.OpacityTransition>
                <TextBlock
                    x:Name="ToastText"
                    FontSize="12"
                    MaxWidth="320"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.TransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 极简高雅 Nordic 细长进度条与悬浮光晕滑块轻量级样式 -->
        <x:Double x:Key="SliderTrackThemeHeight">3.5</x:Double>
        <x:Double x:Key="SliderThumbWidth">12</x:Double>
        <x:Double x:Key="SliderThumbHeight">12</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
    </UserControl.Resources>

    <Border
        Height="90"
        Padding="24,0,24,0"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>

            <!-- 1. 左侧：44x44 迷你封面 + 紧凑标题与红心 + 动态歌词摘要 (Qt6 1:1 紧凑对齐) -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 迷你封面 -->
                <Border
                    Grid.Column="0"
                    Width="44"
                    Height="44"
                    Margin="0,0,12,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <FontIcon
                            x:Name="MiniCoverFallback"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image
                            x:Name="MiniCoverImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 歌曲标题与紧随的红心收藏按钮 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            x:Name="StatusCaptionText"
                            MaxWidth="160"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="未加载曲目"
                            TextTrimming="CharacterEllipsis" />

                        <Button
                            x:Name="FavoriteBtn"
                            Width="24"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="FavoriteBtn_Click"
                            CornerRadius="12"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="添加到我喜欢">
                            <FontIcon
                                x:Name="FavoriteIcon"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xEB51;" />
                        </Button>
                    </StackPanel>

                    <!-- 动态歌词摘要 / 艺术家 -->
                    <TextBlock
                        x:Name="LyricSnippetText"
                        MaxWidth="190"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Klang"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- 2. 中间：核心播放控制按钮簇 + 全宽贯通式时间进度条 -->
            <Grid
                Grid.Column="1"
                Margin="20,0,20,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 居中控制按钮组 -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">

                    <!-- 随机播放 -->
                    <Button
                        x:Name="ShuffleBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="ShuffleBtn_Click"
                        CornerRadius="6"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="随机播放">
                        <FontIcon
                            x:Name="ShuffleIcon"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B1;" />
                    </Button>

                    <!-- 上一曲 -->
                    <Button
                        x:Name="PrevBtn"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Click="PrevBtn_Click"
                        CornerRadius="17"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="上一首 (Ctrl+Left)">
                        <FontIcon FontSize="15" Glyph="&#xE892;" />
                    </Button>

                    <!-- 核心播放/暂停弹性大按钮 (Nordic Sage #6E8277 沉浸色) -->
                    <Button
                        x:Name="PlayPauseBtn"
                        Width="42"
                        Height="42"
                        Padding="0"
                        Click="PlayPauseBtn_Click"
                        CornerRadius="21"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="播放 / 暂停 (Space)">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="PlayPauseScale" CenterX="21" CenterY="21" ScaleX="1.0" ScaleY="1.0" />
                        </Button.RenderTransform>
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontSize="17"
                            Foreground="#FAF9F6"
                            Glyph="&#xE768;" />
                    </Button>

                    <!-- 下一曲 -->
                    <Button
                        x:Name="NextBtn"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Click="NextBtn_Click"
                        CornerRadius="17"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="下一首 (Ctrl+Right)">
                        <FontIcon FontSize="15" Glyph="&#xE893;" />
                    </Button>

                    <!-- 循环模式 -->
                    <Button
                        x:Name="RepeatBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="RepeatBtn_Click"
                        CornerRadius="6"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="循环模式：列表循环">
                        <FontIcon
                            x:Name="RepeatIcon"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8EE;" />
                    </Button>

                    <!-- 倍速切换按钮 -->
                    <Button
                        x:Name="RateBtn"
                        Height="26"
                        Padding="8,0,8,0"
                        Click="RateBtn_Click"
                        CornerRadius="13"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="切换播放倍速">
                        <TextBlock
                            x:Name="RateText"
                            FontSize="11"
                            FontWeight="Medium"
                            Text="1.0x" />
                    </Button>
                </StackPanel>

                <!-- 全宽贯通进度条：两端等宽时间 + 贯通中央细滑轨 -->
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="CurrentTimeText"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00" />

                    <Slider
                        x:Name="TimelineSlider"
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        PointerCaptureLost="TimelineSlider_PointerCaptureLost"
                        PointerPressed="TimelineSlider_PointerPressed"
                        PointerReleased="TimelineSlider_PointerReleased"
                        Value="0" />

                    <TextBlock
                        x:Name="TotalTimeText"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00" />
                </Grid>
            </Grid>

            <!-- 3. 右侧：DSP 均衡器入口胶囊 + 静音与音量滑块 + 百分比 -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <!-- DSP 均衡器药丸按钮 -->
                <Button
                    x:Name="EqBtn"
                    Height="28"
                    Padding="10,0,10,0"
                    Click="EqBtn_Click"
                    CornerRadius="14"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="DSP 声学效果器 &amp; 耳机校准">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xE9E9;" />
                        <TextBlock
                            x:Name="EqBadgeText"
                            FontSize="11"
                            FontWeight="Medium"
                            Text="默认原声" />
                    </StackPanel>
                </Button>

                <!-- 静音开关 -->
                <Button
                    x:Name="VolumeBtn"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="VolumeBtn_Click"
                    CornerRadius="16"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="静音 / 取消静音">
                    <FontIcon
                        x:Name="VolumeIcon"
                        FontSize="15"
                        Glyph="&#xE767;" />
                </Button>

                <!-- 音量细滑块 -->
                <Slider
                    x:Name="VolumeSlider"
                    Width="84"
                    VerticalAlignment="Center"
                    IsThumbToolTipEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="VolumeSlider_ValueChanged"
                    Value="85" />

                <!-- 音量百分比 -->
                <TextBlock
                    x:Name="VolumePctText"
                    Width="30"
                    VerticalAlignment="Center"
                    FontFamily="Consolas, Segoe UI"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="85%"
                    TextAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.TransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Klang_WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:TimeToolTipConverter x:Key="TimeToolTipConverter" />
    </UserControl.Resources>

    <Border
        Height="90"
        Padding="24,0,24,0"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>

            <!-- 1. 左侧：封面 + 标题 / 副标题 + 红心 -->
            <Grid
                Grid.Column="0"
                VerticalAlignment="Center"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 封面 -->
                <Border
                    Grid.Column="0"
                    Width="52"
                    Height="52"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            x:Name="MiniCoverFallback"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image
                            x:Name="MiniCoverImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 标题与副标题（歌手 / 当前歌词） -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="StatusCaptionText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="未加载曲目"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="LyricSnippetText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Klang"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button AutomationProperties.Name="添加到我喜欢"
                    x:Name="FavoriteBtn"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="FavoriteBtn_Click"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="添加到我喜欢">
                    <FontIcon
                        x:Name="FavoriteIcon"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEB51;" />
                </Button>
            </Grid>

            <!-- 2. 中间：核心播放控制按钮簇 + 全宽贯通式时间进度条 -->
            <Grid
                Grid.Column="1"
                Margin="20,0,20,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 居中控制按钮组 -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">

                    <!-- 随机播放 -->
                    <Button AutomationProperties.Name="随机播放"
                        x:Name="ShuffleBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="ShuffleBtn_Click"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="随机播放">
                        <FontIcon
                            x:Name="ShuffleIcon"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B1;" />
                    </Button>

                    <!-- 上一曲 -->
                    <Button AutomationProperties.Name="上一首 (Ctrl+Left)"
                        x:Name="PrevBtn"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Click="PrevBtn_Click"
                        CornerRadius="17"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="上一首 (Ctrl+Left)">
                        <FontIcon FontSize="15" Glyph="&#xE892;" />
                    </Button>

                    <!-- 核心播放/暂停弹性大按钮 (Nordic Sage #6E8277 沉浸色) -->
                    <Button AutomationProperties.Name="播放 / 暂停 (Space)"
                        x:Name="PlayPauseBtn"
                        Width="42"
                        Height="42"
                        Padding="0"
                        Click="PlayPauseBtn_Click"
                        CornerRadius="21"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="播放 / 暂停 (Space)">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="PlayPauseScale" CenterX="21" CenterY="21" ScaleX="1.0" ScaleY="1.0" />
                        </Button.RenderTransform>
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontSize="17"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE768;" />
                    </Button>

                    <!-- 下一曲 -->
                    <Button AutomationProperties.Name="下一首 (Ctrl+Right)"
                        x:Name="NextBtn"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Click="NextBtn_Click"
                        CornerRadius="17"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="下一首 (Ctrl+Right)">
                        <FontIcon FontSize="15" Glyph="&#xE893;" />
                    </Button>

                    <!-- 循环模式 -->
                    <Button AutomationProperties.Name="循环模式：列表循环"
                        x:Name="RepeatBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="RepeatBtn_Click"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="循环模式：列表循环">
                        <FontIcon
                            x:Name="RepeatIcon"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8EE;" />
                    </Button>

                    <!-- 倍速切换按钮 -->
                    <Button AutomationProperties.Name="切换播放倍速"
                        x:Name="RateBtn"
                        Height="26"
                        Padding="8,0,8,0"
                        Click="RateBtn_Click"
                        CornerRadius="13"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="切换播放倍速">
                        <TextBlock
                            x:Name="RateText"
                            FontSize="12"
                            FontWeight="Medium"
                            Text="1.0x" />
                    </Button>
                </StackPanel>

                <!-- 全宽贯通进度条：两端等宽时间 + 贯通中央细滑轨 -->
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="CurrentTimeText"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00" />

                    <Slider
                        x:Name="TimelineSlider"
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ThumbToolTipValueConverter="{StaticResource TimeToolTipConverter}"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="TimelineSlider_ValueChanged"
                        Value="0" />

                    <TextBlock
                        x:Name="TotalTimeText"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00" />
                </Grid>
            </Grid>

            <!-- 3. 右侧：DSP 均衡器入口胶囊 + 静音与音量滑块 + 百分比 -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <!-- DSP 均衡器药丸按钮 -->
                <Button AutomationProperties.Name="DSP 声学效果器 &amp; 耳机校准"
                    x:Name="EqBtn"
                    Height="28"
                    Padding="10,0,10,0"
                    Click="EqBtn_Click"
                    CornerRadius="8"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="DSP 声学效果器 &amp; 耳机校准">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xE9E9;" />
                        <TextBlock
                            x:Name="EqBadgeText"
                            FontSize="12"
                            FontWeight="Medium"
                            Text="默认原声" />
                    </StackPanel>
                </Button>

                <!-- 静音开关 -->
                <Button AutomationProperties.Name="静音 / 取消静音"
                    x:Name="VolumeBtn"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="VolumeBtn_Click"
                    CornerRadius="16"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="静音 / 取消静音">
                    <FontIcon
                        x:Name="VolumeIcon"
                        FontSize="15"
                        Glyph="&#xE767;" />
                </Button>

                <!-- 音量细滑块 -->
                <Slider
                    x:Name="VolumeSlider"
                    Width="84"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="VolumeSlider_ValueChanged"
                    Value="85" />

                <!-- 音量百分比 -->
                <TextBlock
                    x:Name="VolumePctText"
                    Width="30"
                    VerticalAlignment="Center"
                    FontFamily="Consolas, Segoe UI"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="85%"
                    TextAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

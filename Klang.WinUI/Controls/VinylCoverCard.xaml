<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.VinylCoverCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid Width="340" VerticalAlignment="Center">
        <StackPanel Spacing="18">

            <!-- 1. 黑胶唱片 + 艺术封套联动舞台 (280x280 核心区域) -->
            <Grid
                Width="320"
                Height="270"
                HorizontalAlignment="Center">

                <!-- [底层] 真实黑胶唱片 (Vinyl LP Disc)：
                     1. RenderTransformOrigin="0.5,0.5" 确保以圆心为自转轴心，绝不产生偏心乱转！
                     2. RotateTransform 位于 TranslateTransform 之前，确保原地匀速自转后再向右平移！
                     3. 未播放时绝对隐藏在封套后方，播放时丝滑滑出 48px -->
                <Border
                    x:Name="VinylDisc"
                    Width="240"
                    Height="240"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#16171A"
                    BorderBrush="#25272B"
                    BorderThickness="1"
                    CornerRadius="120"
                    Opacity="0"
                    Visibility="Collapsed">

                    <!-- 黑胶唱片同心微凹槽与中心转轴 -->
                    <Grid>
                        <!-- 外圈同心微凹槽环 -->
                        <Border Width="212" Height="212" BorderBrush="#30333A" BorderThickness="1" CornerRadius="106" Opacity="0.35" />
                        <Border Width="182" Height="182" BorderBrush="#30333A" BorderThickness="1" CornerRadius="91" Opacity="0.30" />
                        <Border Width="152" Height="152" BorderBrush="#30333A" BorderThickness="1" CornerRadius="76" Opacity="0.25" />
                        <Border Width="122" Height="122" BorderBrush="#30333A" BorderThickness="1" CornerRadius="61" Opacity="0.20" />

                        <!-- 黑胶中心彩胶贴纸 (Label) -->
                        <Border
                            Width="84"
                            Height="84"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="#111113"
                            BorderThickness="2"
                            CornerRadius="42">
                            <Grid>
                                <FontIcon FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xEC4F;" />
                                <!-- 中心转轴孔 (Spindle Hole) -->
                                <Border
                                    Width="12"
                                    Height="12"
                                    Background="#111113"
                                    CornerRadius="6" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- [顶层] 唱片封套 (Jacket Card)：实心遮蔽底色，彻底杜绝底层黑胶透光穿帮 -->
                <Border
                    x:Name="JacketCard"
                    Width="260"
                    Height="260"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">

                    <Grid>
                        <!-- 默认未加载音乐占位 (Nordic 极简典雅封套风格) -->
                        <Grid x:Name="FallbackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xEC4F;" />
                            </StackPanel>
                        </Grid>

                        <!-- 高清专辑封面图 (圆角剪裁平滑淡入) -->
                        <Border CornerRadius="13">
                            <Grid>
                                <Image
                                    x:Name="CoverImage"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                                <!-- 切歌时盖在上面的旧封面，淡出后隐藏 -->
                                <Image
                                    x:Name="OldCoverImage"
                                    IsHitTestVisible="False"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. 曲目元数据信息 (文字入场动效) -->
            <StackPanel
                x:Name="MetaInfoPanel"
                Margin="4,0,4,0"
                Spacing="5">

                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="暂无播放曲目"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <TextBlock
                    x:Name="ArtistText"
                    FontSize="14"
                    FontWeight="Normal"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="点击左侧栏的按钮导入本地音乐"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <!-- 格式徽标与专辑名 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="QualityBadgeBorder"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Padding="6,2,6,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="QualityBadgeText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="WASAPI · 0ms" />
                    </Border>

                    <TextBlock
                        x:Name="AlbumText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>

            <!-- 3. 实时频谱：24 段圆角柱 + 峰值悬浮点（代码绘制） -->
            <Canvas
                x:Name="SpectrumCanvas"
                Height="32"
                Margin="6,6,6,0"
                HorizontalAlignment="Stretch"
                SizeChanged="SpectrumCanvas_SizeChanged" />
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.VinylCoverCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="340" VerticalAlignment="Center">
        <StackPanel Spacing="18">

            <!-- 1. 黑胶唱片 + 艺术封套联动舞台 (280x280 核心区域) -->
            <Grid
                Width="320"
                Height="270"
                HorizontalAlignment="Center">

                <!-- [底层] 真实黑胶唱片 (Vinyl LP Disc)：未播放时绝对隐藏在封套正后方，播放时阻尼滑出 46px 并旋转 -->
                <Border
                    x:Name="VinylDisc"
                    Width="244"
                    Height="244"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#16171A"
                    BorderBrush="#25272B"
                    BorderThickness="1"
                    CornerRadius="122"
                    Opacity="0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="VinylSlideTransform" X="0" />
                            <RotateTransform x:Name="VinylRotateTransform" Angle="0" CenterX="122" CenterY="122" />
                        </TransformGroup>
                    </Border.RenderTransform>

                    <!-- 黑胶唱片同心纹路与中心标签 -->
                    <Grid>
                        <!-- 外圈同心微凹槽环 -->
                        <Border Width="216" Height="216" BorderBrush="#30333A" BorderThickness="1" CornerRadius="108" Opacity="0.35" />
                        <Border Width="186" Height="186" BorderBrush="#30333A" BorderThickness="1" CornerRadius="93" Opacity="0.30" />
                        <Border Width="156" Height="156" BorderBrush="#30333A" BorderThickness="1" CornerRadius="78" Opacity="0.25" />
                        <Border Width="126" Height="126" BorderBrush="#30333A" BorderThickness="1" CornerRadius="63" Opacity="0.20" />

                        <!-- 黑胶中心彩胶贴纸 (Label) -->
                        <Border
                            Width="88"
                            Height="88"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="#111113"
                            BorderThickness="2"
                            CornerRadius="44">
                            <Grid>
                                <FontIcon FontSize="18" Foreground="#FAF9F6" Glyph="&#xE8D6;" />
                                <!-- 中心转轴孔 (Spindle Hole) -->
                                <Border
                                    Width="12"
                                    Height="12"
                                    Background="#111113"
                                    CornerRadius="6" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- [顶层] 唱片封套 (Jacket Card)：实体圆角与平滑切换过渡 -->
                <Border
                    x:Name="JacketCard"
                    Width="260"
                    Height="260"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CoverScaleTransform" CenterX="130" CenterY="130" ScaleX="1.0" ScaleY="1.0" />
                    </Border.RenderTransform>

                    <Grid>
                        <!-- 默认未加载音乐占位 (Nordic 极简典雅封套风格，告别粗糙双重唱片大图标) -->
                        <Grid x:Name="FallbackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <Border
                                    Width="60"
                                    Height="60"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="30">
                                    <FontIcon
                                        FontSize="24"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xEC4F;" />
                                </Border>
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center"
                                    Text="KLANG STUDIO" />
                            </StackPanel>
                        </Grid>

                        <!-- 高清专辑封面图 (支持平滑淡入淡出动画) -->
                        <Image
                            x:Name="CoverImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. 曲目元数据信息 (文字入场动效) -->
            <StackPanel
                x:Name="MetaInfoPanel"
                Margin="4,0,4,0"
                Spacing="5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MetaTranslateTransform" Y="0" />
                </StackPanel.RenderTransform>

                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="暂无播放曲目"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <TextBlock
                    x:Name="ArtistText"
                    FontSize="13"
                    FontWeight="Normal"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="点击左侧栏按钮导入本地音乐"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <!-- 格式徽标与专辑名 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="QualityBadgeBorder"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Padding="6,2,6,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="QualityBadgeText"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="WASAPI · 0ms" />
                    </Border>

                    <TextBlock
                        x:Name="AlbumText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>

            <!-- 3. 真实音频驱动的 16 频段律动频谱条 (Nordic Spectrum Analyzer) -->
            <Border
                Height="32"
                Padding="12,6,12,6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid x:Name="SpectrumGrid" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">
                    <Border x:Name="Bar0" Grid.Column="0" Width="3.5" Height="4" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar1" Grid.Column="1" Width="3.5" Height="6" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar2" Grid.Column="2" Width="3.5" Height="5" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar3" Grid.Column="3" Width="3.5" Height="8" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar4" Grid.Column="4" Width="3.5" Height="12" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar5" Grid.Column="5" Width="3.5" Height="14" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar6" Grid.Column="6" Width="3.5" Height="10" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar7" Grid.Column="7" Width="3.5" Height="16" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar8" Grid.Column="8" Width="3.5" Height="15" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar9" Grid.Column="9" Width="3.5" Height="11" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar10" Grid.Column="10" Width="3.5" Height="8" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar11" Grid.Column="11" Width="3.5" Height="6" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar12" Grid.Column="12" Width="3.5" Height="9" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar13" Grid.Column="13" Width="3.5" Height="7" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar14" Grid.Column="14" Width="3.5" Height="5" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                    <Border x:Name="Bar15" Grid.Column="15" Width="3.5" Height="4" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.75" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

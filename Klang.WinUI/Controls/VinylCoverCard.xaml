<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.VinylCoverCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid Width="340" VerticalAlignment="Center">
        <StackPanel Spacing="18">

            <!-- 1. 黑胶唱片 + 艺术封套联动舞台 (280x280 核心区域) -->
            <Grid
                Width="320"
                Height="270"
                HorizontalAlignment="Center">

                <!-- [底层] 黑胶唱片。结构：
                     · VinylDisc 整体负责滑出 / 收回和淡入淡出，本身不旋转；
                     · DiscCanvas 画盘面（底色、细密纹路、曲目间隔、固定方向的高光、封套投下的阴影）——
                       真实唱片的反光位置由光源决定，不随唱片转动，所以这一层是静止的；
                     · DiscLabel 是中心贴纸（用专辑封面），只有它在转。 -->
                <Grid
                    x:Name="VinylDisc"
                    Width="240"
                    Height="240"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">

                    <canvas:CanvasControl x:Name="DiscCanvas" Draw="DiscCanvas_Draw" />

                    <Grid
                        x:Name="DiscLabel"
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- 没有封面时的贴纸：强调色 -->
                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <FontIcon
                            x:Name="DiscLabelIcon"
                            Margin="0,0,0,44"
                            FontSize="13"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xEC4F;" />
                        <!-- 专辑封面裁成圆形作贴纸 -->
                        <Ellipse x:Name="DiscLabelCover" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="DiscLabelBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- 贴纸边缘的压痕与中心轴孔 -->
                        <Ellipse Stroke="#66000000" StrokeThickness="1.5" />
                        <Ellipse
                            Width="10"
                            Height="10"
                            Fill="#0B0B0D"
                            Stroke="#40FFFFFF"
                            StrokeThickness="0.8" />
                    </Grid>
                </Grid>
                <!-- [顶层] 唱片封套 (Jacket Card)：实心遮蔽底色，彻底杜绝底层黑胶透光穿帮 -->
                <Border
                    x:Name="JacketCard"
                    Width="260"
                    Height="260"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    PointerCanceled="JacketCard_PointerExited"
                    PointerExited="JacketCard_PointerExited"
                    PointerMoved="JacketCard_PointerMoved">

                    <Grid>
                        <!-- 默认未加载音乐占位 (Nordic 极简典雅封套风格) -->
                        <Grid x:Name="FallbackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon
                                    FontSize="40"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xEC4F;" />
                            </StackPanel>
                        </Grid>

                        <!-- 高清专辑封面图 (圆角剪裁平滑淡入) -->
                        <Border CornerRadius="13">
                            <Grid>
                                <Image
                                    x:Name="CoverImage"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                                <!-- 切歌时盖在上面的旧封面，淡出后隐藏 -->
                                <Image
                                    x:Name="OldCoverImage"
                                    IsHitTestVisible="False"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 鼠标悬停时的高光：圆心跟着鼠标走 -->
                        <Border
                            x:Name="TiltShine"
                            CornerRadius="13"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush
                                    x:Name="TiltShineBrush"
                                    Center="0.5,0.5"
                                    GradientOrigin="0.5,0.5"
                                    RadiusX="0.75"
                                    RadiusY="0.75">
                                    <GradientStop Offset="0" Color="#38FFFFFF" />
                                    <GradientStop Offset="0.45" Color="#12FFFFFF" />
                                    <GradientStop Offset="1" Color="#00FFFFFF" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. 曲目元数据信息 (文字入场动效) -->
            <StackPanel
                x:Name="MetaInfoPanel"
                Margin="4,0,4,0"
                Spacing="5">

                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="暂无播放曲目"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <TextBlock
                    x:Name="ArtistText"
                    FontSize="14"
                    FontWeight="Normal"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="点击左侧栏的按钮导入本地音乐"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <!-- 格式徽标与专辑名 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="QualityBadgeBorder"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Padding="6,2,6,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="QualityBadgeText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="WASAPI · 0ms" />
                    </Border>

                    <TextBlock
                        x:Name="AlbumText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>

            <!-- 3. 实时频谱：24 段圆角柱 + 峰值悬浮点（代码绘制） -->
            <Canvas
                x:Name="SpectrumCanvas"
                Height="32"
                Margin="6,6,6,0"
                HorizontalAlignment="Stretch"
                SizeChanged="SpectrumCanvas_SizeChanged" />
        </StackPanel>
    </Grid>
</UserControl>

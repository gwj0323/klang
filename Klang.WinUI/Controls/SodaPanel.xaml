<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.SodaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Klang_WinUI.Models">
    <UserControl.Resources>
        <Style x:Key="SodaNavStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid Padding="12,14,12,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="HomeTitle" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Grid.Column="1" Width="30" Height="30" Padding="0"
                        Click="RefreshButton_Click" Style="{StaticResource SubtleButtonStyle}" CornerRadius="4">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <PersonPicture x:Name="AccountPicture" Width="28" Height="28" />
                <TextBlock x:Name="AccountName" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Button x:Name="AccountButton" Grid.Column="2" Click="AccountButton_Click" Padding="10,5" CornerRadius="4" />
            </Grid>
            <ScrollViewer x:Name="HomeScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4" Padding="0,0,0,8">
                    <Button x:Name="RecommendButton" Style="{StaticResource SodaNavStyle}" Click="RecommendButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE787;" FontSize="16" />
                            <TextBlock x:Name="RecommendTitle" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoritesButton" Style="{StaticResource SodaNavStyle}" Click="FavoritesButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEB51;" FontSize="16" />
                            <TextBlock x:Name="FavoritesTitle" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Height="1" Margin="8,7,8,7" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="ModesPanel" Spacing="2" />
                    <StackPanel x:Name="ModesLoadingPanel" Orientation="Horizontal" Spacing="8" Margin="8" Visibility="Collapsed">
                        <ProgressRing x:Name="ModesRing" Width="16" Height="16" IsActive="False" />
                        <TextBlock x:Name="ModesLoadingText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="PlaybackStatusPanel" Visibility="Collapsed" Padding="8,8" Margin="0,4,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ProgressRing x:Name="PlaybackRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="PlaybackStatusText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <InfoBar x:Name="NoticeBar" Severity="Warning" IsOpen="False" IsClosable="True" Margin="0,4,0,4">
                        <InfoBar.ActionButton><Button x:Name="RetryButton" Click="RetryButton_Click" /></InfoBar.ActionButton>
                    </InfoBar>
                    <Expander x:Name="TracksExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed" Margin="0,6,0,0">
                        <Expander.Header>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TracksHeading" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackCountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <Grid x:Name="TracksView" RowSpacing="8" Margin="-16,-8,-16,-8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button x:Name="PlayAllButton" Click="PlayAllButton_Click" HorizontalAlignment="Stretch" CornerRadius="4" Margin="4,0,4,0" />
                            <Grid Grid.Row="1">
                                <ListView x:Name="TracksList" MaxHeight="350" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TracksList_ItemClick" HorizontalContentAlignment="Stretch">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackItem">
                                            <Grid Padding="0,5" MinHeight="54" ColumnSpacing="9">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Grid><FontIcon Glyph="&#xE8D6;" FontSize="16" /><Image Source="{x:Bind CoverThumb, Mode=OneWay}" Stretch="UniformToFill" /></Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="TracksEmptyPanel" Spacing="10" Padding="12,20" HorizontalAlignment="Center">
                                    <ProgressRing x:Name="TracksRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                                    <FontIcon x:Name="EmptyIcon" Glyph="&#xE8D6;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="TracksEmptyText" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="LoadMoreButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="LoadMoreButton_Click" CornerRadius="4" Visibility="Collapsed" Margin="4,0,4,0" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.NavigationPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Klang_WinUI.Models"
    xmlns:local="using:Klang_WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 曲目行 -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="models:TrackItem">
            <Grid
                Height="56"
                Padding="8,0,8,0"
                Background="Transparent"
                ColumnSpacing="12"
                ContextRequested="TrackItem_ContextRequested"
                ToolTipService.ToolTip="{x:Bind FormatBadge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 封面缩略图（没有封面时显示音符占位） -->
                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind CoverThumb, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind DurationStr}"
                    TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- 分组标题行 -->
        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:GroupHeader">
            <Grid Height="30" Padding="8,0,8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind CountText}" />
            </Grid>
        </DataTemplate>

        <local:TrackListTemplateSelector
            x:Key="TrackListSelector"
            GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}"
            TrackTemplate="{StaticResource TrackTemplate}" />
    </UserControl.Resources>

    <Border
        Width="286"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">

        <Grid Padding="12,14,12,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部分类：官方 SelectorBar（自带选中指示条动画） -->
            <SelectorBar
                x:Name="TabSelector"
                Grid.Row="0"
                SelectionChanged="TabSelector_SelectionChanged">
                <SelectorBarItem x:Name="TabAllItem" IsSelected="True" Tag="all" Text="全部" />
                <SelectorBarItem Tag="fav" Text="喜欢" />
                <SelectorBarItem Tag="playlists" Text="歌单" />
                <SelectorBarItem Tag="netease" Text="云端" />
            </SelectorBar>

            <!-- 2. 搜索框 -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                Height="32"
                CornerRadius="4"
                PlaceholderText="搜索歌名 / 歌手 / 专辑…"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />

            <!-- 3. 辅助工具栏 (数量统计 + 添加 + 排序) -->
            <Grid Grid.Row="2" Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TrackCountText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="共 0 首" />

                <!-- 添加本地文件夹按钮 -->
                <Button AutomationProperties.Name="添加本地音乐文件夹"
                    x:Name="AddFolderBtn"
                    Grid.Column="2"
                    Height="28"
                    Margin="0,0,6,0"
                    Padding="10,0,10,0"
                    VerticalAlignment="Center"
                    Click="AddFolderBtn_Click"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="添加本地音乐文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xED25;" />
                        <TextBlock FontSize="12" FontWeight="Medium" Text="添加" />
                    </StackPanel>
                </Button>

                <!-- 排序与分组：合并为一个菜单 -->
                <Button
                    x:Name="ViewOptionsBtn"
                    Grid.Column="4"
                    Height="28"
                    Padding="10,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="排序与分组"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="排序与分组">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8CB;" />
                        <TextBlock x:Name="ViewOptionsText" FontSize="12" Text="整理" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ViewOptionsFlyout">
                            <MenuFlyoutSubItem Text="排序">
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="default" Text="默认顺序" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="title" Text="歌名" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="artist" Text="歌手" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="album" Text="专辑" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="duration" Text="时长" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="分组">
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="none" Text="不分组" />
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="artist" Text="按歌手" />
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="album" Text="按专辑" />
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="folder" Text="按目录" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- 4. 歌曲列表 / 歌单列表 / 空状态 -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 打开某个歌单时顶部的返回条 -->
                <Grid
                    x:Name="PlaylistHeader"
                    Margin="0,0,0,6"
                    ColumnSpacing="6"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.Name="返回歌单列表"
                        Height="28"
                        Padding="8,0,8,0"
                        Click="PlaylistBackBtn_Click"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="返回歌单列表">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        x:Name="PlaylistHeaderText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="TracksListView"
                        DoubleTapped="TracksListView_DoubleTapped"
                        IsItemClickEnabled="True"
                        ItemClick="TracksListView_ItemClick"
                        ItemTemplateSelector="{StaticResource TrackListSelector}"
                        SelectionMode="Single" />

                    <!-- 歌单列表 -->
                    <Grid
                        x:Name="PlaylistsPanel"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                            Height="32"
                            HorizontalAlignment="Stretch"
                            Click="NewPlaylistBtn_Click"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock FontSize="12" Text="新建歌单" />
                            </StackPanel>
                        </Button>
                        <ListView
                            x:Name="PlaylistsListView"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="PlaylistsListView_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PlaylistEntry">
                                    <Grid
                                        Height="44"
                                        Padding="8,0,8,0"
                                        Background="Transparent"
                                        ColumnSpacing="10"
                                        ContextRequested="PlaylistItem_ContextRequested">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE8FD;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind CountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 云端（网易云） -->
                    <local:CloudPanel x:Name="CloudView" Visibility="Collapsed" />

                    <!-- 空状态提示 -->
                    <StackPanel
                        x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="EmptyIcon"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <TextBlock
                            x:Name="EmptyText"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="曲库暂无音乐"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="EmptyImportBtn"
                            HorizontalAlignment="Center"
                            Click="AddFolderBtn_Click"
                            Content="导入音乐"
                            FontSize="12"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

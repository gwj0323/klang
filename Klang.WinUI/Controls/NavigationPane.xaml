<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Klang_WinUI.Controls.NavigationPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Klang_WinUI.Models"
    xmlns:local="using:Klang_WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 顶部分类标签：五个标签要在 286px 的侧栏里放下（英文标签更长），内边距收紧一点 -->
        <Style TargetType="SelectorBarItem">
            <Setter Property="Padding" Value="7,6,7,6" />
        </Style>

        <!-- 曲目行 -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="models:TrackItem">
            <Grid
                Height="56"
                Padding="8,0,8,0"
                Background="Transparent"
                ColumnSpacing="12"
                ContextRequested="TrackItem_ContextRequested"
                Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                PointerCanceled="TrackRow_PointerReleased"
                PointerCaptureLost="TrackRow_PointerReleased"
                PointerEntered="TrackRow_PointerEntered"
                PointerExited="TrackRow_PointerExited"
                PointerPressed="TrackRow_PointerPressed"
                PointerReleased="TrackRow_PointerReleased"
                ToolTipService.ToolTip="{x:Bind RowToolTip, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 当前播放行的竖条由 ListViewItem 自带的选中指示条负责，这里不再重复画 -->

                <!-- 封面缩略图（没有封面时显示音符占位）；鼠标悬停时盖一层播放图标 -->
                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <!-- 缩略图加载完成后淡入 -->
                        <Image
                            ImageOpened="TrackThumb_ImageOpened"
                            Source="{x:Bind CoverThumb, Mode=OneWay}"
                            Stretch="UniformToFill" />
                        <!-- 正在播放的行：随音乐跳动的小频谱 -->
                        <local:NowPlayingBars Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                        <!-- 悬停时的播放图标（必须是最后一个子元素，代码按位置取它） -->
                        <Grid
                            x:Name="HoverPlay"
                            Background="#8C000000"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <FontIcon
                                FontSize="16"
                                Foreground="White"
                                Glyph="&#xE768;" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind DurationStr}"
                    TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- 分组标题行 -->
        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:GroupHeader">
            <Grid Height="30" Padding="8,0,8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind CountText}" />
            </Grid>
        </DataTemplate>

        <local:TrackListTemplateSelector
            x:Key="TrackListSelector"
            GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}"
            TrackTemplate="{StaticResource TrackTemplate}" />
    </UserControl.Resources>

    <Border
        Width="286"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">

        <Grid Padding="12,14,12,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部分类：官方 SelectorBar（自带选中指示条动画） -->
            <SelectorBar
                x:Name="TabSelector"
                Grid.Row="0"
                Visibility="Collapsed"
                SelectionChanged="TabSelector_SelectionChanged">
                <SelectorBarItem x:Name="TabAllItem" IsSelected="True" Tag="all" Text="全部" />
                <SelectorBarItem Tag="fav" Text="喜欢" />
                <SelectorBarItem Tag="albums" Text="专辑" />
                <SelectorBarItem Tag="playlists" Text="歌单" />
                <SelectorBarItem Tag="netease" Text="云端" />
            </SelectorBar>

            <!-- 2. 搜索框 -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                Margin="0,-10,0,0"
                Height="32"
                CornerRadius="4"
                PlaceholderText="搜索歌名 / 歌手 / 专辑…"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />

            <!-- 3. 辅助工具栏 (数量统计 + 添加 + 排序) -->
            <Grid Grid.Row="2" Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TrackCountText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="共 0 首" />

                <!-- 扫描进度：贴在工具栏底部的细进度条 -->
                <ProgressBar
                    x:Name="ScanBar"
                    Grid.ColumnSpan="5"
                    Margin="0,0,0,-2"
                    VerticalAlignment="Bottom"
                    Canvas.ZIndex="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <!-- 添加本地文件夹按钮 -->
                <Button AutomationProperties.Name="添加本地音乐文件夹"
                    x:Name="AddFolderBtn"
                    Grid.Column="2"
                    Height="28"
                    Margin="0,0,6,0"
                    Padding="10,0,10,0"
                    VerticalAlignment="Center"
                    Click="AddFolderBtn_Click"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="添加本地音乐文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xED25;" />
                        <TextBlock FontSize="12" FontWeight="Medium" Text="添加" />
                    </StackPanel>
                </Button>

                <!-- 排序与分组：合并为一个菜单 -->
                <Button
                    x:Name="ViewOptionsBtn"
                    Grid.Column="4"
                    Height="28"
                    Padding="10,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="排序与分组"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="排序与分组">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8CB;" />
                        <TextBlock x:Name="ViewOptionsText" FontSize="12" Text="整理" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ViewOptionsFlyout">
                            <MenuFlyoutSubItem Text="排序">
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="default" Text="默认顺序" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="title" Text="歌名" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="artist" Text="歌手" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="album" Text="专辑" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="duration" Text="时长" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="added" Text="最近添加" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="played" Text="最近播放" />
                                <RadioMenuFlyoutItem Click="SortItem_Click" GroupName="LibSort" Tag="plays" Text="播放最多" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="FilterSubItem" Text="筛选">
                                <RadioMenuFlyoutItem Click="QualityFilter_Click" GroupName="LibQuality" Tag="0" Text="全部音质" IsChecked="True" />
                                <RadioMenuFlyoutItem Click="QualityFilter_Click" GroupName="LibQuality" Tag="1" Text="无损及以上" />
                                <RadioMenuFlyoutItem Click="QualityFilter_Click" GroupName="LibQuality" Tag="2" Text="仅 Hi-Res" />
                                <RadioMenuFlyoutItem Click="QualityFilter_Click" GroupName="LibQuality" Tag="-1" Text="仅有损" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="FilterNoCover" Click="MissingFilter_Click" Text="缺少封面" />
                                <ToggleMenuFlyoutItem x:Name="FilterNoAlbum" Click="MissingFilter_Click" Text="缺少专辑 / 歌手信息" />
                                <ToggleMenuFlyoutItem x:Name="FilterNoLyrics" Click="MissingFilter_Click" Text="缺少歌词（无同名 .lrc 文件）" />
                                <ToggleMenuFlyoutItem x:Name="FilterMissingFile" Click="MissingFilter_Click" Text="文件丢失" />
                                <ToggleMenuFlyoutItem x:Name="FilterFake" Click="MissingFilter_Click" Text="疑似伪无损" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="ClearFilters_Click" Text="清除筛选" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="分组">
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="none" Text="不分组" />
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="artist" Text="按歌手" />
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="album" Text="按专辑" />
                                <RadioMenuFlyoutItem Click="GroupItem_Click" GroupName="LibGroup" Tag="folder" Text="按目录" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="曲库工具">
                                <MenuFlyoutItem Click="FindDuplicates_Click" Text="检查重复歌曲…" />
                                <MenuFlyoutItem Click="FindMissing_Click" Text="检查丢失文件…" />
                                <MenuFlyoutItem Click="AcousticMap_Click" Text="声学地图…" />
                                <MenuFlyoutItem Click="RescanNow_Click" Text="立即重新扫描文件夹" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="ResetRoam_Click" Text="重置漫游学习数据…" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- 4. 歌曲列表 / 歌单列表 / 空状态 -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 打开某个歌单时顶部的返回条 -->
                <Grid
                    x:Name="PlaylistHeader"
                    Margin="0,0,0,6"
                    ColumnSpacing="6"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.Name="返回歌单列表"
                        Height="28"
                        Padding="8,0,8,0"
                        Click="PlaylistBackBtn_Click"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="返回歌单列表">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        x:Name="PlaylistHeaderText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="TracksListView"
                        DoubleTapped="TracksListView_DoubleTapped"
                        DragItemsCompleted="TracksListView_DragItemsCompleted"
                        IsItemClickEnabled="True"
                        ItemClick="TracksListView_ItemClick"
                        ItemTemplateSelector="{StaticResource TrackListSelector}"
                        SelectionMode="Single" />

                    <!-- 歌单列表 -->
                    <Grid
                        x:Name="PlaylistsPanel"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Height="32"
                                HorizontalAlignment="Stretch"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                                    <TextBlock FontSize="12" Text="新建" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="NewPlaylistBtn_Click" Text="新建歌单…" />
                                        <MenuFlyoutItem Click="NewSmartPlaylistBtn_Click" Text="新建智能歌单…" />
                                        <MenuFlyoutItem Click="ImportM3uBtn_Click" Text="导入 M3U 歌单…" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="PlaylistsListView"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="PlaylistsListView_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PlaylistEntry">
                                    <Grid
                                        Height="44"
                                        Padding="8,0,8,0"
                                        Background="Transparent"
                                        ColumnSpacing="10"
                                        ContextRequested="PlaylistItem_ContextRequested">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind CountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 专辑墙 -->
                    <GridView
                        x:Name="AlbumsGridView"
                        IsItemClickEnabled="True"
                        ItemClick="AlbumsGridView_ItemClick"
                        SelectionMode="None"
                        Visibility="Collapsed">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:AlbumEntry">
                                <StackPanel
                                    Width="116"
                                    Margin="2,2,2,10"
                                    Background="Transparent"
                                    ContextRequested="AlbumItem_ContextRequested"
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind Name}">
                                    <Border
                                        Width="116"
                                        Height="116"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Grid>
                                            <FontIcon
                                                FontSize="32"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Glyph="&#xE93C;" />
                                            <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 云端（网易云） -->
                    <local:CloudPanel x:Name="CloudView" Visibility="Collapsed" />

                    <!-- 空状态提示 -->
                    <StackPanel
                        x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="EmptyIcon"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <TextBlock
                            x:Name="EmptyText"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="曲库暂无音乐"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="EmptyImportBtn"
                            HorizontalAlignment="Center"
                            Click="AddFolderBtn_Click"
                            Content="导入音乐"
                            FontSize="12"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Klang_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Klang_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 统一全局字体：告别亚像素模糊渲染，确保 DirectWrite 清晰锐利 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>

            <!-- 强调色（按钮、滑块、选中态等）不再覆盖，直接跟随 Windows 系统设置的强调色 -->
        </ResourceDictionary>
    </Application.Resources>
</Application>

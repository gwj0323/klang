<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Klang_WinUI.Views.DesktopLyricWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Klang_WinUI.Controls"
    Title="桌面歌词">

    <!-- 整窗亚克力 + 深色着色；工具栏鼠标移入时才浮现 -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited"
        RequestedTheme="Dark">

        <Border
            x:Name="WindowCard"
            Padding="28,10,28,12"
            Background="#8C0E1115">
            <Grid>
                <!-- 歌词：当前句（逐字高亮） + 译文或下一句 -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <Viewbox
                        HorizontalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <controls:KaraokeText
                            x:Name="MainLine"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="White"
                            WrapText="False" />
                    </Viewbox>
                    <TextBlock
                        x:Name="SubLine"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Foreground="#99FFFFFF"
                        MaxLines="1"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 悬浮工具栏 -->
                <StackPanel
                    x:Name="Toolbar"
                    Margin="0,-4,-16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button x:Name="PrevBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="上一首" Click="PrevBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="上一首">
                        <FontIcon FontSize="14" Glyph="&#xE892;" />
                    </Button>
                    <Button x:Name="PlayPauseBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="播放 / 暂停" Click="PlayPauseBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="播放 / 暂停">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="14" Glyph="&#xE768;" />
                    </Button>
                    <Button x:Name="NextBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="下一首" Click="NextBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="下一首">
                        <FontIcon FontSize="14" Glyph="&#xE893;" />
                    </Button>
                    <Rectangle Width="1" Height="16" Margin="4,0,4,0" Fill="#33FFFFFF" />
                    <Button x:Name="FontDecBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="缩小字号" Click="FontDecBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="缩小字号">
                        <FontIcon FontSize="12" Glyph="&#xE71F;" />
                    </Button>
                    <Button x:Name="FontIncBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="放大字号" Click="FontIncBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="放大字号">
                        <FontIcon FontSize="16" Glyph="&#xE8E9;" />
                    </Button>
                    <Button x:Name="CloseBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="关闭桌面歌词" Click="CloseBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="关闭桌面歌词">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Klang_WinUI.Views.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="迷你播放器">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">

        <Grid x:Name="Card" Padding="14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 封面：点击回到主窗口 -->
            <Button
                x:Name="CoverBtn"
                Width="104"
                Height="104"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="还原主窗口"
                Click="RestoreBtn_Click"
                CornerRadius="8"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="还原主窗口">
                <Grid Width="104" Height="104">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                        <FontIcon
                            x:Name="MiniCoverFallback"
                            FontSize="30"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                    </Border>
                    <Border CornerRadius="8">
                        <Image
                            x:Name="MiniCoverImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Border>
                </Grid>
            </Button>

            <Grid Grid.Column="1" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题：右侧留出悬浮按钮的位置 -->
                <TextBlock
                    x:Name="MiniTitleText"
                    Margin="0,0,56,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="未加载曲目"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="MiniArtistText"
                    Grid.Row="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Klang"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="MiniLyricText"
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />

                <!-- 进度 -->
                <Grid Grid.Row="3" VerticalAlignment="Bottom">
                    <Slider
                        x:Name="MiniTimelineSlider"
                        Height="24"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="MiniTimelineSlider_ValueChanged"
                        Value="0" />
                </Grid>

                <!-- 时间 + 控制 -->
                <Grid Grid.Row="4">
                    <TextBlock
                        x:Name="MiniTimeText"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00 / 00:00" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button x:Name="MiniPrevBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="上一首" Click="MiniPrevBtn_Click" CornerRadius="16" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="上一首">
                            <FontIcon FontSize="14" Glyph="&#xE892;" />
                        </Button>
                        <Button x:Name="MiniPlayPauseBtn" Width="36" Height="36" Padding="0" AutomationProperties.Name="播放 / 暂停" Click="MiniPlayPauseBtn_Click" CornerRadius="18" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="MiniPlayPauseIcon" FontSize="15" Glyph="&#xE768;" />
                        </Button>
                        <Button x:Name="MiniNextBtn" Width="32" Height="32" Padding="0" AutomationProperties.Name="下一首" Click="MiniNextBtn_Click" CornerRadius="16" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="下一首">
                            <FontIcon FontSize="14" Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 右上角：还原 / 关闭（鼠标移入才显示） -->
            <StackPanel
                x:Name="TopButtons"
                Grid.Column="1"
                Margin="0,-6,-6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Opacity="0"
                Orientation="Horizontal"
                Spacing="0">
                <Button x:Name="RestoreBtn" Width="28" Height="28" Padding="0" AutomationProperties.Name="还原主窗口" Click="RestoreBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="还原主窗口">
                    <FontIcon FontSize="12" Glyph="&#xE740;" />
                </Button>
                <Button x:Name="CloseBtn" Width="28" Height="28" Padding="0" AutomationProperties.Name="关闭迷你窗口" Click="CloseBtn_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="关闭迷你窗口">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

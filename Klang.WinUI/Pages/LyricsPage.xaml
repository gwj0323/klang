<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klang_WinUI.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,24,36,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：唱盘黑胶 / 专辑大图封面 -->
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">
            <Border
                Width="320"
                Height="320"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <FontIcon
                        FontSize="88"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8D6;" />
                    <Image
                        x:Name="StageCoverImage"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock
                    x:Name="StageTitleText"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Arrival of the Birds" />
                <TextBlock
                    x:Name="StageArtistText"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The Cinematic Orchestra · The Crimson Wing" />
                <StackPanel
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Padding="6,2,6,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="FLAC 24bit / 96kHz" />
                    </Border>
                    <Border
                        Padding="6,2,6,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="120 FPS 极速刷新" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 右侧：居中丝滑歌词舞台 -->
        <ScrollViewer
            Grid.Column="1"
            Padding="20,0,20,0"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel
                VerticalAlignment="Center"
                Spacing="24">
                <TextBlock
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="♪ ~ 钢琴纯音乐前奏 ~ ♪" />
                <TextBlock
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The wings of hope carry through the storm" />
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="Arrival of the birds, rising high above" />
                <TextBlock
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Where sunlight kisses the edge of the sky" />
                <TextBlock
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="And echoes fade into endless serenity" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

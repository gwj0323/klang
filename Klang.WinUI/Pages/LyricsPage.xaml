<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klang_WinUI.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,20,36,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：黑胶唱盘与专辑艺术封面 -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20">
                <!-- 封面容器 -->
                <Border
                    Width="300"
                    Height="300"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <FontIcon
                            x:Name="StageFallbackIcon"
                            FontSize="76"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image
                            x:Name="StageCoverImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 曲目元数据信息 -->
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock
                        x:Name="StageTitleText"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="未播放曲目"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        x:Name="StageArtistText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Klang - 沉浸式听音空间"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Padding="7,2,7,2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="StageBadgeText"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="WASAPI · 0ms" />
                        </Border>

                        <Border
                            Padding="7,2,7,2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="毫秒级同步" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 右侧：动态丝滑居中滚动歌词舞台 -->
        <ScrollViewer
            x:Name="LyricsScrollViewer"
            Grid.Column="1"
            Padding="24,0,24,0"
            HorizontalScrollBarVisibility="Disabled"
            IsScrollInertiaEnabled="True"
            VerticalScrollBarVisibility="Hidden">

            <ItemsControl
                x:Name="LyricsItemsControl"
                Padding="0,260,0,260">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,4,0,4"
                            Padding="14,10,14,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="LyricLine_Click"
                            CornerRadius="10"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="点击跳转到此时刻播放">
                            <Button.RenderTransform>
                                <ScaleTransform
                                    ScaleX="{Binding ScaleX}"
                                    ScaleY="{Binding ScaleY}" />
                            </Button.RenderTransform>

                            <StackPanel
                                HorizontalAlignment="Center"
                                Spacing="4">
                                <!-- 主歌词 -->
                                <TextBlock
                                    FontSize="{Binding MainFontSize}"
                                    FontWeight="{Binding FontWeight}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Opacity="{Binding LineOpacity}"
                                    Text="{Binding Text}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <!-- 翻译 / 副歌词 -->
                                <TextBlock
                                    FontSize="{Binding SubFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="{Binding LineOpacity}"
                                    Text="{Binding Sub}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>

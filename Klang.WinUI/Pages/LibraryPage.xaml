<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klang_WinUI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题与状态 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Text="本地曲库" />
                    <Border
                        VerticalAlignment="Center"
                        Padding="8,2,8,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            x:Name="TrackCountText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="0 首曲目" />
                    </Border>
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="支持 FLAC、WAV、APE、M4A、MP3 及 CUE 自动分轨 · WASAPI 256KB 极速输出" />
            </StackPanel>

            <!-- 操作按钮组 -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="AddFolderBtn"
                    Click="AddFolderBtn_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xED25;" />
                        <TextBlock Text="添加音乐文件夹" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ScanBtn"
                    Click="ScanBtn_Click"
                    Style="{StaticResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="扫描更新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 搜索与筛选工具栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="搜索歌名、歌手、专辑..."
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="12">
                <ComboBox
                    x:Name="SortComboBox"
                    Width="140"
                    SelectedIndex="0"
                    SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="默认排序" />
                    <ComboBoxItem Content="按歌名" />
                    <ComboBoxItem Content="按歌手" />
                    <ComboBoxItem Content="按专辑" />
                    <ComboBoxItem Content="按时长" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 歌曲列表 / 空状态 -->
        <Grid Grid.Row="2">
            <!-- 列表视图 -->
            <ListView
                x:Name="TracksListView"
                ItemClick="TracksListView_ItemClick"
                IsItemClickEnabled="True"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,8,6,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{Binding Index}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Artist}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{Binding Album}"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Grid.Column="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="6,1,6,1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding FormatBadge}" />
                            </Border>

                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding DurationStr}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态提示 -->
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="Visible">
                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="暂未导入音乐文件" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="点击上方「添加音乐文件夹」开始享受无损母带音质" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

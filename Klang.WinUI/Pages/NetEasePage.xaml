<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Klang_WinUI.Pages.NetEasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Text="网易云音乐" />
                    <Border
                        VerticalAlignment="Center"
                        Padding="8,2,8,2"
                        Background="#26E03E3E"
                        BorderBrush="#40E03E3E"
                        BorderThickness="1"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#E03E3E"
                            Text="Cloud Sync" />
                    </Border>
                </StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="扫码同步每日推荐、自建歌单与 VIP 无损 / 超清母带音质" />
            </StackPanel>

            <Button
                x:Name="LoginBtn"
                Grid.Column="1"
                Click="LoginBtn_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="15" Glyph="&#xED14;" />
                    <TextBlock x:Name="LoginBtnText" Text="扫码安全登录" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 登录横幅卡片 -->
        <Border
            Grid.Row="1"
            Padding="20,16,20,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    FontSize="28"
                    Foreground="#E03E3E"
                    Glyph="&#xE753;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="AccountStatusTitle"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="尚未连接网易云音乐账号" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="登录后即可同步「我喜欢的音乐」、歌单并解锁高品质音频流与动态歌词" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="LoginBtn_Click"
                    Content="立即登录" />
            </Grid>
        </Border>

        <!-- 云端内容展示区 -->
        <TabView Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem Header="每日推荐" IsClosable="False">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEC05;" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="登录后即可获取由算法为你量身定制的每日 30 首推荐曲目" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="我的歌单" IsClosable="False">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8B9;" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="暂未同步云端歌单" />
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>

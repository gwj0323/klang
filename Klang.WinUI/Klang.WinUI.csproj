<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Klang_WinUI</RootNamespace>
    <!-- 版本号：“关于”页显示它，检查更新时拿它和 GitHub 上最新的 WinUI 发布比较。发新版时在这里改 -->
    <Version>2.5.2</Version>
    <IncludeSourceRevisionInVersion>false</IncludeSourceRevisionInVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ComputeSharp 的源生成器要求（GPU 着色器） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\AppLogo.png" />
    <!-- 发布（dotnet publish）时也要把图标等资源带上，否则发布包里没有窗口图标和关于页的 Logo -->
    <Content Update="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 界面语言包：键 = 中文原文，值 = 译文；往这个文件夹里加 xx.json 就多一门语言 -->
    <Content Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- 歌词用 Win2D 逐帧按真实字号绘制（不再缩放文字纹理），文字才能一直锐利 -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="ComputeSharp.WinUI" Version="3.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- 未打包 + 自包含发布时，应用自己的资源索引 (Klang.WinUI.pri) 默认不会被复制到发布目录，
       缺了它启动时会报 “Cannot locate resource from ms-appx:///MainWindow.xaml” -->
  <Target Name="CopyAppPriToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)$(TargetName).pri"
                             RelativePath="$(TargetName).pri"
                             CopyToPublishDirectory="PreserveNewest"
                             Condition="Exists('$(OutDir)$(TargetName).pri')" />
    </ItemGroup>
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- WinUI 的 XAML 通过反射创建控件，裁剪会让 NavigationPane 等自定义控件无法实例化（启动即崩溃），因此不裁剪 -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>

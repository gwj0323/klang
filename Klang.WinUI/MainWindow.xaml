<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Klang_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Klang_WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Klang"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 深度对标 Qt 版 WinUITitleBar (高度 46px，保留右侧 140px 给系统最小化/最大化/关闭按钮) -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="46"
            Padding="12,0,140,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：侧栏折叠开关 + 品牌图标与文字 -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button AutomationProperties.Name="折叠 / 展开曲库侧栏"
                    x:Name="SidebarToggleBtn"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="SidebarToggleBtn_Click"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="折叠 / 展开曲库侧栏">
                    <FontIcon FontSize="14" Glyph="&#xE700;" />
                </Button>

                <Image
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="Assets/AppIcon.ico" />

                <TextBlock
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Klang" />
            </StackPanel>

            <!-- 中间拖拽空白区 -->
            <Border Grid.Column="1" Background="Transparent" />

            <!-- 右侧：歌词菜单 / 视图菜单 / 设置 -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button AutomationProperties.Name="歌词相关功能"
                    x:Name="LyricMenuBtn"
                    Height="32"
                    Padding="10,0,8,0"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="歌词相关功能">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                        <TextBlock FontSize="12" Text="歌词设置" />
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem Text="副行显示">
                                <RadioMenuFlyoutItem x:Name="SubTransItem" Click="SubModeItem_Click" GroupName="SubMode" Tag="trans" Text="翻译" />
                                <RadioMenuFlyoutItem x:Name="SubRomaItem" Click="SubModeItem_Click" GroupName="SubMode" Tag="roma" Text="罗马音" />
                                <RadioMenuFlyoutItem x:Name="SubBothItem" Click="SubModeItem_Click" GroupName="SubMode" Tag="both" Text="翻译 + 罗马音" />
                                <RadioMenuFlyoutItem x:Name="SubOffItem" Click="SubModeItem_Click" GroupName="SubMode" Tag="off" Text="关" />
                            </MenuFlyoutSubItem>
                            <ToggleMenuFlyoutItem
                                x:Name="DesktopLyricItem"
                                Click="DesktopLyricBtn_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+D"
                                Text="桌面歌词" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Click="PosterBtn_Click"
                                Text="生成歌词海报…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button AutomationProperties.Name="窗口与显示模式"
                    x:Name="ViewMenuBtn"
                    Height="32"
                    Padding="10,0,8,0"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="窗口与显示模式">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE71D;" />
                        <TextBlock FontSize="12" Text="视图" />
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="ImmersiveBtn_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+I"
                                Text="沉浸模式" />
                            <MenuFlyoutItem
                                Click="MiniPlayerBtn_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+M"
                                Text="迷你窗口" />
                            <MenuFlyoutItem
                                Click="FullscreenBtn_Click"
                                KeyboardAcceleratorTextOverride="F11"
                                Text="全屏" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button AutomationProperties.Name="偏好设置"
                    x:Name="SettingsBtn"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Click="SettingsBtn_Click"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="偏好设置">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 中央核心工作区 (Workspace)：Qt 1:1 三栏一体化布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：NavigationPane (曲库分类、即时搜索、排序、歌曲列表) -->
            <Grid
                x:Name="SidebarHost"
                Grid.Column="0"
                SizeChanged="SidebarHost_SizeChanged">
                <controls:NavigationPane
                    x:Name="LeftNavPane"
                    HorizontalAlignment="Left" />

                <!-- 折叠后的竖排图标栏 -->
                <StackPanel
                    x:Name="SidebarRail"
                    Width="56"
                    Padding="8,12,8,12"
                    HorizontalAlignment="Left"
                    Spacing="4"
                    Visibility="Collapsed">
                    <Button x:Name="RailAll" Width="40" Height="40" Padding="0" AutomationProperties.Name="全部" Click="RailTab_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" Tag="all" ToolTipService.ToolTip="全部">
                        <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                    </Button>
                    <Button x:Name="RailFav" Width="40" Height="40" Padding="0" AutomationProperties.Name="喜欢" Click="RailTab_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" Tag="fav" ToolTipService.ToolTip="喜欢">
                        <FontIcon FontSize="16" Glyph="&#xEB51;" />
                    </Button>
                    <Button x:Name="RailAlbums" Width="40" Height="40" Padding="0" AutomationProperties.Name="专辑" Click="RailTab_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" Tag="albums" ToolTipService.ToolTip="专辑">
                        <FontIcon FontSize="16" Glyph="&#xE93C;" />
                    </Button>
                    <Button x:Name="RailPlaylists" Width="40" Height="40" Padding="0" AutomationProperties.Name="歌单" Click="RailTab_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" Tag="playlists" ToolTipService.ToolTip="歌单">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                    </Button>
                    <Button x:Name="RailCloud" Width="40" Height="40" Padding="0" AutomationProperties.Name="云端" Click="RailTab_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" Tag="netease" ToolTipService.ToolTip="云端">
                        <FontIcon FontSize="16" Glyph="&#xE753;" />
                    </Button>
                    <Rectangle Height="1" Margin="4,6,4,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button Width="40" Height="40" Padding="0" AutomationProperties.Name="搜索" Click="RailSearch_Click" CornerRadius="4" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="搜索 (Ctrl+F)">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 右侧舞台：stage_container (VinylCoverCard + LyricsStageControl) -->
            <Grid
                x:Name="StageGrid"
                Grid.Column="1"
                Padding="46,24,42,24"
                ColumnSpacing="48"
                SizeChanged="StageGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StageCoverColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 黑胶艺术封面与声学规格 -->
                <controls:VinylCoverCard
                    x:Name="StageCoverCard"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 窄窗口时：封面收成歌词上方的小头图（宽窗口下隐藏） -->
                    <Grid
                        x:Name="NarrowHeader"
                        Margin="0,0,0,8"
                        ColumnSpacing="12"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Grid>
                                <FontIcon
                                    FontSize="22"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8D6;" />
                                <Image x:Name="NarrowCover" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="NarrowTitle"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="暂无播放曲目"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="NarrowArtist"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- 实时丝滑居中歌词舞台 -->
                    <controls:LyricsStageControl
                        x:Name="StageLyricsControl"
                        Grid.Row="1" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. 底部：TransportBar (毛玻璃磨砂播放控制栏) -->
        <controls:TransportBar
            x:Name="BottomTransportBar"
            Grid.Row="2" />

        <!-- 沉浸式全屏层（覆盖整个窗口） -->
        <controls:ImmersiveView
            x:Name="ImmersiveLayer"
            Grid.RowSpan="3"
            Visibility="Collapsed" />
    </Grid>
</Window>
